GRAWP001
REALNAME -OutfitCmd
IMAGE 
SCRIPT
//#CLIENTSIDE

// Chat commands from the old Valikorlia "Outfit" weapon (generated by outfit_gen.py):
// sethead / setbody / setshield / sethat <file>, skin / coat / sleeves / shoes / belt <color>, /all <color>,
// /saveoutfit <1-10>, /loadoutfit <1-10>, /outfitgui (saver window), /filebrowser (opens the browser, -Outfit).
function onCreated() {
if (!isObject("ChatTextProfile")) {
new GuiTextProfile("ChatTextProfile") {
fontcolor = {0, 0, 0};
}
}
this.buildSaver();
}


