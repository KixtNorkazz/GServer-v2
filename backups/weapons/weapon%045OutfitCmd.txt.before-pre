function canuse(f) {
if (this.isValp(f)) {
return this.isOwnValp(f);
}
return true;
}

function cleanName(t) {
if (t.starts("..") || t.starts("/") || t.starts("<") || t.tokenize("/").size() > 1 || t.tokenize("<").size() > 1) {
return "";
}
return t;
}

function isValp(n) {
return (n.starts("valp_") || n.starts("Valp_") || n.starts("VALP_"));
}

function isOwnValp(n) {
if (clientr.staff) {
return true;
}
return n.starts("valp_" @ player.account @ "_");
}

function say(t) {
Os_Status.text = t;
echo("-OutfitCmd: " @ t);
}

function onPlayerChats() {
temp.c = player.chat;
if (temp.c.starts("sethead ")) {
this.cmdSet(0, temp.c.substring(8));
} else if (temp.c.starts("setbody ")) {
this.cmdSet(1, temp.c.substring(8));
} else if (temp.c.starts("setshield ")) {
this.cmdSet(2, temp.c.substring(10));
} else if (temp.c.starts("sethat ")) {
if (!temp.c.ends(".gani")) {
this.cmdSet(3, temp.c.substring(7));
}
} else if (temp.c.starts("skin ")) {
this.cmdColor(0, temp.c.substring(5));
} else if (temp.c.starts("coat ")) {
this.cmdColor(1, temp.c.substring(5));
} else if (temp.c.starts("sleeves ")) {
this.cmdColor(2, temp.c.substring(8));
} else if (temp.c.starts("shoes ")) {
this.cmdColor(3, temp.c.substring(6));
} else if (temp.c.starts("belt ")) {
this.cmdColor(4, temp.c.substring(5));
} else if (temp.c.starts("/all ")) {
for (temp.i = 0; temp.i < 5; temp.i++) {
this.cmdColor(temp.i, temp.c.substring(5));
}
} else if (temp.c.starts("/saveoutfit ")) {
this.saveSlot(int(temp.c.substring(12)));
player.chat = "";
} else if (temp.c.starts("/loadoutfit ")) {
this.loadSlot(int(temp.c.substring(12)));
player.chat = "";
} else if (temp.c == "/outfitgui") {
this.showSaver();
player.chat = "";
} else if (temp.c == "/filebrowser" || temp.c == "/outfit") {
client.openwindow = "outfit";
player.chat = "";
}
}

function cmdSet(c, f) {
temp.f = this.cleanName(f);
if (temp.f == "" || !this.canuse(temp.f)) {
this.say("Cannot use that file");
return;
}
if (c == 0) {
player.head = temp.f;
} else if (c == 1) {
player.body = temp.f;
} else if (c == 2) {
player.shield = temp.f;
} else {
player.attr[1] = temp.f;
}
player.chat = "";
this.say("Set to: " @ temp.f);
}

function cmdColor(i, col) {
temp.t = this.cleanName(col);
if (temp.t != "") {
player.colors[i] = temp.t;
}
player.chat = "";
}

function slotGet(n) {

if (n == 1) {
return client.of_s1;
}

if (n == 2) {
return client.of_s2;
}

if (n == 3) {
return client.of_s3;
}

if (n == 4) {
return client.of_s4;
}

if (n == 5) {
return client.of_s5;
}

if (n == 6) {
return client.of_s6;
}

if (n == 7) {
return client.of_s7;
}

if (n == 8) {
return client.of_s8;
}

if (n == 9) {
return client.of_s9;
}

if (n == 10) {
return client.of_s10;
}

return "";
}

function slotSet(n, v) {

if (n == 1) {
client.of_s1 = v;
}

if (n == 2) {
client.of_s2 = v;
}

if (n == 3) {
client.of_s3 = v;
}

if (n == 4) {
client.of_s4 = v;
}

if (n == 5) {
client.of_s5 = v;
}

if (n == 6) {
client.of_s6 = v;
}

if (n == 7) {
client.of_s7 = v;
}

if (n == 8) {
client.of_s8 = v;
}

if (n == 9) {
client.of_s9 = v;
}

if (n == 10) {
client.of_s10 = v;
}

}

function saveSlot(n) {
if (n < 1 || n > 10) {
this.say("Invalid outfit number (1-10)");
return;
}
temp.s = player.head @ "|" @ player.body @ "|" @ player.shield @ "|" @ player.attr[1] @ "|" @ player.colors[0] @ "|" @ player.colors[1] @ "|" @ player.colors[2] @ "|" @ player.colors[3] @ "|" @ player.colors[4];
this.slotSet(n, temp.s);
this.say("Saved outfit " @ n);
this.refreshSaver();
}

function loadSlot(n) {
if (n < 1 || n > 10) {
return;
}
temp.s = this.slotGet(n);
if (temp.s.length() < 3) {
this.say("Outfit " @ n @ " is empty");
return;
}
temp.p = temp.s.tokenize("|");
if (temp.p.size() < 9) {
return;
}
player.head = temp.p[0];
player.body = temp.p[1];
player.shield = temp.p[2];
player.attr[1] = temp.p[3];
for (temp.i = 0; temp.i < 5; temp.i++) {
player.colors[temp.i] = temp.p[4 + temp.i];
}
this.say("Loaded outfit " @ n);
}

function showSaver() {
this.refreshSaver();
Outfit_Saver.position = {int((screenwidth - 360) / 2), int((screenheight - 364) / 2)};
Outfit_Saver.show();
}

function refreshSaver() {

temp.s = this.slotGet(1);
if (temp.s.length() < 3) {
Os_L0.text = "1: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L0.text = "1: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(2);
if (temp.s.length() < 3) {
Os_L1.text = "2: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L1.text = "2: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(3);
if (temp.s.length() < 3) {
Os_L2.text = "3: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L2.text = "3: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(4);
if (temp.s.length() < 3) {
Os_L3.text = "4: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L3.text = "4: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(5);
if (temp.s.length() < 3) {
Os_L4.text = "5: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L4.text = "5: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(6);
if (temp.s.length() < 3) {
Os_L5.text = "6: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L5.text = "6: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(7);
if (temp.s.length() < 3) {
Os_L6.text = "7: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L6.text = "7: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(8);
if (temp.s.length() < 3) {
Os_L7.text = "8: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L7.text = "8: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(9);
if (temp.s.length() < 3) {
Os_L8.text = "9: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L8.text = "9: " @ temp.p[0] @ " / " @ temp.p[1];
}

temp.s = this.slotGet(10);
if (temp.s.length() < 3) {
Os_L9.text = "10: (empty)";
} else {
temp.p = temp.s.tokenize("|");
Os_L9.text = "10: " @ temp.p[0] @ " / " @ temp.p[1];
}

}

