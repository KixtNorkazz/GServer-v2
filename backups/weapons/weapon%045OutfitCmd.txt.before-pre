if (isObject("Outfit_Saver")) {
Outfit_Saver.destroy();
}
new GuiWindowCtrl("Outfit_Saver") {
clientrelative = true;
clientextent = "360,340";
canclose = true;
canmaximize = false;
canminimize = false;
canmove = true;
canresize = false;
closequery = false;
destroyonhide = false;
text = "Outfit Saver";
