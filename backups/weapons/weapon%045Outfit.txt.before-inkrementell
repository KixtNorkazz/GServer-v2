function toggle() {
if (Outfit_Window.visible) {
this.closeWin();
} else {
this.opened();
if (client.winext == "off") {
Outfit_Window.position = {int((screenwidth - 502) / 2), int((screenheight - 532) / 2)};
}
client.openwindow = "menuhide";
Outfit_Window.show();
}
}

function closeWin() {
this.cleanup();
Outfit_Window.hide();
}

