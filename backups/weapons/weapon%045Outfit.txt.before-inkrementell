}

function pl(c) {
if (c == 0) {
return this.p0;
}
if (c == 1) {
return this.p1;
}
if (c == 2) {
return this.p2;
}
return this.p3;
}

function rebuild() {
this.loadData();
temp.c = this.cat;
if (temp.c > 3) {
return;
}
temp.a = this.pl(temp.c);
temp.res = {};
temp.pre = "valp_" @ player.account.lower() @ "_";
temp.f = this.filter.lower();
for (temp.n: temp.a) {
temp.ok = true;
temp.l = temp.n.lower();
if (temp.l.starts("valp_")) {
if (!temp.l.starts(temp.pre) && !clientr.staff) {
temp.ok = false;
}
}
if (temp.ok && temp.f.length() > 0) {
if (temp.l.pos(temp.f) < 0) {
temp.ok = false;
}
}
if (temp.ok) {
temp.res.add(temp.n);
}
}
this.cur = temp.res;
}

function list() {
return this.cur;
