if (this.again % 5 == 0 && Outfit_Window.visible) {
this.refreshCells();
}
}
if (Outfit_Window.visible) {
if (Of_Find.text != this.lastFind) {
this.doFind();
}
}
if (client.openwindow == "outfit") {
client.openwindow = "";
this.toggle();
}
setTimer(0.2);
