x = 10;
y = 166;
width = 296;
height = 20;
text = "";
}
new GuiButtonCtrl("Gu_R7") {
x = 10;
y = 188;
width = 296;
height = 20;
text = "";
}
new GuiButtonCtrl("Gu_Up") {
x = 312;
y = 34;
width = 40;
height = 24;
text = "^";
}
new GuiButtonCtrl("Gu_Down") {
x = 312;
