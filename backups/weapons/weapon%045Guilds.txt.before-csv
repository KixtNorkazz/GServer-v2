GRAWP001
REALNAME -Guilds
IMAGE 
SCRIPT
//#CLIENTSIDE
function onCreated() {
echo("-Guilds: onCreated");
this.gnames = {};
this.granks = {};
this.gmembers = {};
this.cur = 0;
this.top = 0;
this.sel = -1;
this.msg = "";
this.tick = 0;
this.extgen = int(client.winextgen);
this.build();
setTimer(0.2);
}

function build() {
if (!isObject("ChatTextProfile")) {
new GuiTextProfile("ChatTextProfile") {
fontcolor = {0, 0, 0};
}
}
if (isObject("Guild_Window"))
Guild_Window.destroy();
new GuiWindowCtrl("Guild_Window") {
clientrelative = true;
clientextent = "376,432";
canclose = true;
canmaximize = false;
canminimize = false;
canmove = true;
canresize = false;
closequery = false;
destroyonhide = false;
externalwindow = "";
isexternal = (client.winext != "off");
text = "Guild";
new GuiTextCtrl("Gu_Name") {
profile = ChatTextProfile;
x = 10;
y = 8;
width = 240;
height = 18;
text = "";
}
new GuiButtonCtrl("Gu_Prev") {
x = 252;
y = 4;
width = 48;
height = 24;
text = "<";
}
new GuiButtonCtrl("Gu_Next") {
x = 304;
y = 4;
width = 48;
height = 24;
text = ">";
}
new GuiButtonCtrl("Gu_R0") {
x = 10;
