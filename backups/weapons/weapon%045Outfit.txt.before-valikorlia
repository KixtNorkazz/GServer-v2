function toggle() {
if (Outfit_Window.visible) {
this.cancel();
} else {
this.opened();
if (client.winext == "off") {
Outfit_Window.position = {int((screenwidth - 470) / 2), int((screenheight - 470) / 2)};
}
client.openwindow = "menuhide";
Outfit_Window.show();
}
}

function opened() {
this.o0 = player.head;
this.o1 = player.body;
this.o2 = player.shield;
this.o3 = player.attr[1];
this.v0 = player.head;
this.v1 = player.body;
this.v2 = player.shield;
this.v3 = player.attr[1];
Of_c0.text = player.colors[0];
Of_c1.text = player.colors[1];
Of_c2.text = player.colors[2];
Of_c3.text = player.colors[3];
Of_c4.text = player.colors[4];
Of_Status.text = "";
this.setCat(this.cat);
}

function list() {
if (this.cat == 0) {
return this.l0;
}
if (this.cat == 1) {
return this.l1;
}
if (this.cat == 2) {
return this.l2;
}
return this.l3;
}

function currentValue() {
if (this.cat == 0) {
return this.v0;
}
if (this.cat == 1) {
return this.v1;
}
if (this.cat == 2) {
return this.v2;
}
return this.v3;
}

