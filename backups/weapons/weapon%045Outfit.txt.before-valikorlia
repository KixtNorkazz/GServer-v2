temp.l = this.list();
temp.n0 = temp.l[this.top * 6];
echo("-Outfit: page cat=" @ this.cat @ " top=" @ this.top @ " first=" @ temp.n0 @ " exists=" @ fileexists(temp.n0));
}

function fillCell(im, btn, i) {
temp.l = this.list();
temp.k = this.top * 6 + i;
if (temp.k >= temp.l.size()) {
im.hide();
btn.hide();
return;
}
temp.nm = temp.l[temp.k];
showimg(300 + i, temp.nm, player.x, player.y);
changeimgzoom(300 + i, 0.05);
temp.x = 10 + (i % 6) * 72;
if (this.cat == 0) {
this.setPart(im, temp.nm, 0, 64, 32, 32);
im.x = temp.x + 4;
im.width = 64;
im.height = 64;
} else if (this.cat == 1) {
this.setPart(im, temp.nm, 64, 0, 32, 32);
im.x = temp.x + 4;
im.width = 64;
im.height = 64;
} else if (this.cat == 2) {
this.setPart(im, temp.nm, 14, 0, 16, 20);
im.x = temp.x + 20;
im.width = 32;
im.height = 40;
} else {
this.setPart(im, temp.nm, 96, 0, 48, 48);
im.x = temp.x + 4;
im.width = 64;
im.height = 64;
}
if (temp.nm == this.currentValue()) {
btn.text = "*";
} else {
btn.text = "";
}
im.show();
btn.show();
}

function pick(i) {
temp.l = this.list();
temp.k = this.top * 6 + i;
if (temp.k >= temp.l.size()) {
return;
}
temp.v = temp.l[temp.k];
if (this.cat == 0) {
this.v0 = temp.v;
player.head = temp.v;
} else if (this.cat == 1) {
this.v1 = temp.v;
player.body = temp.v;
} else if (this.cat == 2) {
