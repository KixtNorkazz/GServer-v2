Of_c2.hide();
Of_c2_L.hide();
Of_c3.hide();
Of_c3_L.hide();
Of_c4.hide();
Of_c4_L.hide();
}
}

function setCat(c) {
this.cat = c;
if (c == 4) {
this.again = 0;
this.hideCells();
this.showColors(true);
Of_Info.text = "";
return;
}
this.showColors(false);
temp.l = this.list();
temp.cur = this.currentValue();
this.top = 0;
for (temp.i = 0; temp.i < temp.l.size(); temp.i++) {
if (temp.l[temp.i] == temp.cur) {
this.top = int(temp.i / 6);
break;
}
}
this.clampTop();
this.showPage();
}

function maxTop() {
temp.l = this.list();
temp.m = int((temp.l.size() + 5) / 6) - 4;
if (temp.m < 0) {
temp.m = 0;
}
return temp.m;
}

function clampTop() {
temp.m = this.maxTop();
if (this.top > temp.m) {
this.top = temp.m;
}
if (this.top < 0) {
this.top = 0;
}
}

function scrollRows(d) {
if (this.cat == 4) {
return;
}
this.top = this.top + d;
this.clampTop();
this.showPage();
}

function onWheelUp() {
this.scrollRows(-1);
}

function onWheelDown() {
this.scrollRows(1);
}

