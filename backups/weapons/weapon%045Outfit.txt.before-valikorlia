// v6 outfit browser (F2). Tabs Head / Body / Shield / Hat are pages with a grid of pictures facing the player.
// Click a picture to put it on the character. Mouse wheel or ^ v scrolls. Apply keeps, Cancel puts the old outfit back.
function onCreated() {
echo("-Outfit: onCreated");
this.cat = 0;
this.top = 0;
this.again = 0;
this.extgen = int(client.winextgen);
this.l0 = {};
for (temp.t: this.headNumbers().tokenize())
this.l0.add("head" @ temp.t @ ".png");
this.l1 = this.bodyNames().tokenize();
this.l2 = this.shieldNames().tokenize();
this.l3 = this.hatNames().tokenize();
echo("-Outfit: lists " @ this.l0.size() @ "/" @ this.l1.size() @ "/" @ this.l2.size() @ "/" @ this.l3.size());
this.build();
echo("-Outfit: built, window=" @ isObject("Outfit_Window"));
setTimer(0.2);
}

