function onCreated() {
echo("-Players: onCreated");
this.pa = {};
this.pn = {};
this.pg = {};
this.pk = {};
this.pl = {};
this.dt = {};
this.di = {};
this.da = {};
this.ua = {};
this.uk = {};
this.ck = {};
this.cl = {};
this.top = 0;
this.msg = "";
this.mkey = "";
this.tick = 0;
this.phase = 0;
this.extgen = int(client.winextgen);
this.build();
setTimer(0.2);
}

