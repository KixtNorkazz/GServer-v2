function openRow(i) {
temp.k = this.top + i;
if (temp.k >= this.dt.size() || this.di[temp.k] < 0) {
return;
}
this.openMsg(this.pa[this.di[temp.k]]);
}

function openMsg(key) {
this.mkey = key;
this.clearUnread(key);
temp.title = "Message to " @ key;
if (key == "*mass") {
temp.title = "Mass message to everybody";
} else if (key == "*guild") {
temp.title = "Message to your guild";
} else {
for (temp.i = 0; temp.i < this.pa.size(); temp.i++) {
if (this.pa[temp.i] == key) {
temp.title = "Message to " @ this.who(key, this.pn[temp.i]);
}
}
}
this.buildMsg();
Msg_Window.text = temp.title;
if (client.winext == "off") {
Msg_Window.position = {int((screenwidth - 380) / 2) + 40, int((screenheight - 300) / 2) + 30};
}
Msg_Window.show();
this.showLines();
this.refresh();
}

function showLines() {
temp.disp = {};
for (temp.i = 0; temp.i < this.cl.size(); temp.i++) {
if (this.ck[temp.i] == this.mkey) {
temp.s = this.cl[temp.i];
temp.n = temp.s.length();
temp.p = 0;
while (temp.p < temp.n) {
temp.disp.add(temp.s.substring(temp.p, 52));
temp.p = temp.p + 52;
}
}
}
while (temp.disp.size() < 8) {
temp.disp.add("");
}
Mg_L0.text = temp.disp[temp.disp.size() - 8];
Mg_L1.text = temp.disp[temp.disp.size() - 7];
Mg_L2.text = temp.disp[temp.disp.size() - 6];
Mg_L3.text = temp.disp[temp.disp.size() - 5];
Mg_L4.text = temp.disp[temp.disp.size() - 4];
Mg_L5.text = temp.disp[temp.disp.size() - 3];
Mg_L6.text = temp.disp[temp.disp.size() - 2];
Mg_L7.text = temp.disp[temp.disp.size() - 1];
}

function sendMsg() {
temp.t = Mg_Text.text;
if (temp.t == "" || this.mkey == "") {
return;
}
if (this.mkey == "*mass") {
triggeraction(0, 0, "gr.mass", temp.t);
} else if (this.mkey == "*guild") {
triggeraction(0, 0, "gr.guildmsg", "", temp.t);
} else {
triggeraction(0, 0, "gr.pm", this.mkey, temp.t);
}
Mg_Text.text = "";
}

function scrollRows(d) {
temp.m = this.dt.size() - 13;
if (temp.m < 0) {
temp.m = 0;
}
this.top = this.top + d;
if (this.top > temp.m) {
this.top = temp.m;
}
if (this.top < 0) {
this.top = 0;
}
this.refresh();
}

function Pl_Pop.onAction() {
toggleExternal();
}

function Pl_Up.onAction() {
scrollRows(-1);
}

function Pl_Down.onAction() {
scrollRows(1);
}

function Pl_Mass.onAction() {
openMsg("*mass");
}

function Pl_Guild.onAction() {
openMsg("*guild");
}

function Mg_Send.onAction() {
sendMsg();
}

function Pl_Open0.onAction() {
openRow(0);
}

function Pl_Open1.onAction() {
openRow(1);
}

function Pl_Open2.onAction() {
openRow(2);
}

function Pl_Open3.onAction() {
openRow(3);
}

function Pl_Open4.onAction() {
openRow(4);
}

function Pl_Open5.onAction() {
openRow(5);
}

function Pl_Open6.onAction() {
openRow(6);
}

function Pl_Open7.onAction() {
openRow(7);
}

function Pl_Open8.onAction() {
openRow(8);
}

function Pl_Open9.onAction() {
openRow(9);
}

function Pl_Open10.onAction() {
openRow(10);
}

function Pl_Open11.onAction() {
openRow(11);
}

function Pl_Open12.onAction() {
openRow(12);
}

function onTimeOut() {
if (client.openwindow == "players") {
client.openwindow = "";
this.toggle();
}
this.checkWinExt();
this.tick = this.tick + 1;
if (this.tick % 2 == 0) {
if (this.phase == 0) {
this.phase = 1;
} else {
this.phase = 0;
}
if (Players_Window.visible && this.ua.size() > 0) {
this.refresh();
}
}
if (Players_Window.visible && this.tick % 25 == 0) {
this.ask();
}
setTimer(0.2);
}
SCRIPTEND
