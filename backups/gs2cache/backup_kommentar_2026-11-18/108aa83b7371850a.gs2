//#CLIENTSIDE
function onCreated() {
  this.x = this.x+.4;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "head13.gif";
  this.body = "val_coatbody100.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  // setcharprop #m,0
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Merchant Kipling";
  this.dir = 1;
}
