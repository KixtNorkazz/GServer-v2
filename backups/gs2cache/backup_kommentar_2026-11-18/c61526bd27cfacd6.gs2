//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.head = "head1277.png";
  this.body = "val_hobo_body101.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  // setcharprop #m,0
  setcharani("crossarms", NULL);
  this.swordpower = 1;
  this.attr[1] = "hatnoland.png";
  this.shield = "no-shield.png";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Joseph Stanely, Cartographer";
  this.dir = 2;
}
