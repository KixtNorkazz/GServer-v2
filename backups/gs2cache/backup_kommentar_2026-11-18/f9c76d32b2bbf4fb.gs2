//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "head264.png";
  this.body = "val_arwind-smeewnedit-body100.png";
  this.colors[0] = "orange";
  this.colors[1] = "white";
  this.colors[2] = "white";
  this.colors[3] = "brown";
  this.colors[4] = "gray";
  // setcharprop #m,0
  setcharani("val_pillory", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Obnoxious Pilloried Drunk";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("EGHHGHHHHH!");
  sleep(4);
  message();
}
