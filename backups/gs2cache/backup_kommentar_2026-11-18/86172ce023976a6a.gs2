//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_nohead.png";
  this.body = "val_nobody.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  // setcharprop #m,0
  setcharani("merchantcart-idle", NULL);
  this.swordpower = 1;
  this.shield = "ryo250-woodenspearshield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "";
  this.dir = 1;
}
