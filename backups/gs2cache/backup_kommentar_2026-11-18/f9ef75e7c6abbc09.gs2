function onCreated() {
  showcharacter();
  this.head = "val-nadrion-valikorliansoldier.png";
  this.body = "theblindone-eleanorknight-body101.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  // setcharprop #m,0
  this.nick = "Valikorlian Soldier";
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.dir = 3;
  setcharani("idle", NULL);
  this.hearts = 0;
}

