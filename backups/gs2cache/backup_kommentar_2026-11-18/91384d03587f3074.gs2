//#CLIENTSIDE
function onCreated() {
  gs1_always();
  setshape2(2, 4, {
0,0
0,0
0,0
22,22
});
  showimg(0, "fire.gif", this.x+.1, this.y-1.9);
  showimg(1, "light2.png", this.x-3.1, this.y-3.2);
}

function onPlayerEnters() {
  gs1_always();
  setshape2(2, 4, {
0,0
0,0
0,0
22,22
});
  showimg(0, "fire.gif", this.x+.1, this.y-1.9);
  showimg(1, "light2.png", this.x-3.1, this.y-3.2);
}

function gs1_always() {
  if (lighteffectsenabled) {
    changeimgcolors(0, 1, .5, 0, .8);
    changeimgcolors(1, 1, .5, 0, .8);
    changeimgzoom(0, .5);
    changeimgzoom(1, .75);
  }
}
