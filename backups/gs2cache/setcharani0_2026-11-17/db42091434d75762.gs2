//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "tinderstick-shield.gif";
  this.head = "sky-zangkender4.gif";
  this.body = "tindertotpersonalbody2.gif";
  this.colors[0] = "orange";
  this.colors[1] = "yellow";
  this.chat = "Sail to Northpoint? Say 'Sail to Northpoint'";
  this.colors[2] = "blue";
  this.colors[3] = "brown";
  this.colors[4] = "cynober";
  setcharani("0", NULL);
  this.nick = "Kender Sailor";
  setcharani("idle", NULL);
  this.dir = 2;
}

function onPlayerEnters() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}

function onPlayerTouchsMe() {
  say2("'Ello!#bSpendin' time at the docks?");
}

function onTimeOut() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}
