//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "no-shield.gif";
  this.head = "head7.png";
  this.body = "drakdark-body.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 0;
  this.ap = 100;
  this.nick = "Greg the Engineer";
}

function onPlayerTouchsMe() {
  say2("Bob told me to stay here#band watch this so it don't#bfall and break.");
}
