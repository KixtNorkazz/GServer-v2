//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "ryo250-woodenspearshield.gif";
  this.head = "theblindone-talboh-head2.gif";
  this.body = "arwind-rangerbody3fix.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "Militiaman of (Valdyr)";
  this.dir = 2;
}

function onPlayerEnters() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}

function onTimeOut() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}
