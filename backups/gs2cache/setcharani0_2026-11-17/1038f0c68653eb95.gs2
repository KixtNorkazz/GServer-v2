//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "valp_theblindone_head31.gif";
  this.body = "val_coatbody100.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Travelling Craftsman Forbes";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("I thought I'd peddle me goods o'er in Hightown but the guard turned me away! Called me a 'churl!' The nerve!");
  sleep(4);
  message();
}
