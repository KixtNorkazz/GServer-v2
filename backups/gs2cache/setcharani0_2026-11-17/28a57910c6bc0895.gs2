function onCreated() {
  showcharacter();
  this.attr[1] = "hat-lancershoulders.gif";
  this.head = "val-nadrion-valikorliansoldier.png";
  this.body = "nadrion_valikorlian-nation-knighttemplar.gif";
  this.body = "valikorlia-knightbody.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Invasion Force Soldier of (Valikorlia)";
  this.dir = 1;
  setcharani("idle", NULL);
  this.hearts = 0;
}

function onPlayerTouchsMe() {
  say2("Say \"ruins\" to go to the ruins!");
}
