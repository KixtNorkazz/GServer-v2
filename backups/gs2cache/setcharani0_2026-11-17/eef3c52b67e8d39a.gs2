  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("val-weapon-crossbow_idle", NULL);
  this.dir = 2;
  this.ap = 100;
}
