  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "Dead Bridgar";
  setcharani("valikorlia_motoxbow2-passive-idle", NULL);
  this.dir = 2;
  setcharani("dead2", NULL);
  this.ap = 100;
}
