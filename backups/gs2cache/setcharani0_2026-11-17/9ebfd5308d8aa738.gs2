//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showcharacter();
  this.attr[1] = "hat-lancershoulders.gif";
  this.head = "val-nadrion-valikorliansoldier.png";
  this.body = "nadrion_valikorlian-nation-knighttemplar.gif";
  this.body = "valikorlia-knightbody.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "ryo250-woodenspearshield.gif";
  this.shieldpower = 1;
  this.dir = 1;
  setcharani("idle", NULL);
  this.hearts = 0;
}

function onPlayerTouchsMe() {
  gs1_always();
  if (((player.account == "Criosi")||(player.account == "ssj2sal"))) {
    say2("Hello sir");
  }
}

function gs1_always() {
  if ((player.account == "Criosi")||(player.account == "ssj2sal")) {
    if (this.playerchats&&(player.chat == "Move")) {
      hide();
      sleep(1.5);
      show();
    }
  }
}
