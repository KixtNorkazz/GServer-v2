//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showtext(1, this.x+1.78, "y+.55", "Comic Sans MS", "bc", "Soldier Captain");
  changeimgzoom(1, .75);
  changeimgvis(2, 2);
}

function onPlayerChats() {
  gs1_always();
  if ((player.chat == "Soldier Captain")) {
    player.body = "valikorlia-knightbody.gif";
    player.attr[1] = "hat-valnation-nadrion-knightpaudrons.png";
    player.head = "zazenp2p-bigas.gif";
    player.shield = "blackscabbard-shield.gif";
  }
}

function gs1_always() {
  showcharacter();
  this.attr[1] = "hat-valnation-nadrion-knightpaudrons.png";
  this.shield = "blackscabbard-shield.gif";
  this.head = "zazenp2p-bigas.gif";
  this.body = "zangus-newval-body202.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 2;
}
