//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "suirikuhalberdshield.gif";
  this.head = "jacobbpeters-adventurerhead3.gif";
  this.body = "arwind-marseillesbody2.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "Royal Guard";
  setcharani("idle", NULL);
  this.dir = 2;
  this.ap = 100;
}

function onPlayerTouchsMe() {
  say2("Grrreat te meet ya.");
}
