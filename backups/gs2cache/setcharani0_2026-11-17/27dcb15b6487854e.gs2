//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_nightblade3-head2fixed.png";
  this.body = "cythus-body-edited-by-his-buddy-rue.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Amused Patron";
  this.dir = 0;
}

function onPlayerTouchsMe() {
  message("Now THAT'S what I'm talking about! WHIMSYYYY!");
  sleep(4);
  message();
}
