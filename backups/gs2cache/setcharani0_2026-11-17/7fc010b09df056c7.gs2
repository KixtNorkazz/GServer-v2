//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_pride-head9.png";
  this.body = "val_arwind-smeewnedit-body100.png";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("val_sit", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Farmer";
  this.dir = 0;
}

function onPlayerTouchsMe() {
  message("I'd like to be an adventurer but I just don't have any motivation.. If somebody would give me a push, I know I could do it..");
  sleep(4);
  message();
}
