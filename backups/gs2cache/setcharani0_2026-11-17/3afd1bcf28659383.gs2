//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "suirikuhalberdshield.gif";
  this.head = "theblindone-dwarf-head.gif";
  this.body = "moto-bridgetonbody100.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "Royal Guard";
  setcharani("idle", NULL);
  this.dir = 2;
  this.ap = 100;
}

function onPlayerTouchsMe() {
  say2("Keep yer feet on th' ground!");
}
