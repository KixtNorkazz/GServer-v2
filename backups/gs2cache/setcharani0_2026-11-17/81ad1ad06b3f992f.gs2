//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showtext(1, this.x+1.78, "y+.55", "Comic Sans MS", "bc", "Light Guard");
  changeimgzoom(1, .75);
  changeimgvis(2, 2);
}

function onPlayerChats() {
  gs1_always();
  if ((player.chat == "Light Guard")) {
    player.body = "monkeyswede-niorildragoniusbody.png";
    player.shield = "shieldbuckler.gif";
  }
}

function gs1_always() {
  showcharacter();
  this.shield = "shieldbuckler.gif";
  this.head = "head980.png";
  this.body = "monkeyswede-niorildragoniusbody.png";
  this.colors[0] = "lightgray";
  this.colors[1] = "lightgray";
  this.colors[2] = "blue";
  this.colors[3] = "darkblue";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 2;
}
