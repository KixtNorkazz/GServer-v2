//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "kain-shield.png";
  this.head = "val_vicepersonalhead1.gif";
  this.body = "arwind-racoonbody2.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 3;
  this.ap = 100;
}
