//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "head7.png";
  this.body = "valp_theblindone_body100.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("crossarms", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Esthras Town Worker";
  this.dir = 0;
}

function onPlayerTouchsMe() {
  say2("I like this new regime.#bThey appreciate a good barricade!#bDon't give me that look.");
}
