//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.ap = 100;
  this.shield = "no-shield.gif";
  this.attr[1] = "hat-jennyshat2.gif";
  this.head = "val-rphead.gif";
  this.body = "zarhyn_the_1337-alliancebody102.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  this.nick = "Gunther Albrecht, Reiksguard of (The Legion of Steel)";
  setcharani("0", NULL);
  setcharani("dead4", NULL);
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("Have you seen the postings about Warholm's enslavement of the blasted Lizardmen?");
  sleep(5);
  message();
}
