function onCreated() {
  showcharacter();
  this.shield = "suirikuhalberdshield.gif";
  this.head = "jacobbpeters-adventurerhead3.gif";
  this.body = "moto-bridgetonbody100.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "";
  setcharani("val-weapon-crossbow_idle", NULL);
  this.dir = 1;
  this.ap = 100;
}
