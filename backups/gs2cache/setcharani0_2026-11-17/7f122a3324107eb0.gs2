//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showtext(1, this.x+1.78, "y+.55", "Comic Sans MS", "bc", "Squire");
  changeimgzoom(1, .75);
  changeimgvis(2, 2);
}

function onPlayerChats() {
  gs1_always();
  if ((player.chat == "Squire")) {
    player.shield = "#2,no-shield.gif";
    player.body = "nadrion_valikorlian-nation-soldierbody.png";
  }
}

function gs1_always() {
  showcharacter();
  this.shield = "no-shield.gif";
  this.head = "head1172.png";
  this.body = "nadrion_valikorlian-nation-soldierbody.png";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 2;
}
