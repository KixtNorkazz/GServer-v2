function onCreated() {
  showcharacter();
  this.shield = "ryo250-woodenspearshield.gif";
  this.head = "val-arbitrary-head.gif";
  this.body = "arwind-racoonbody2.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "Gary Blackwell";
  setcharani("val-weapon-crossbow_idle", NULL);
  this.dir = 2;
  this.ap = 100;
}

