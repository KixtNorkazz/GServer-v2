//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "head1277.png";
  this.body = "val_minomato_body171-7.png";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("crossarms", NULL);
  this.swordpower = 1;
  this.attr[1] = "hatnoland.png";
  this.shield = "no-shield.png";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Joseph Stanely, Cartographer";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  say2("What're you lookin' at, bub?");
}
