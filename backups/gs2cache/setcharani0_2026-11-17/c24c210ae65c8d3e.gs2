//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.head = "head1.png";
  this.body = "val-pegason-body110.gif";
  this.attr[1] = "hat1-celdin-helm.gif";
  this.colors[0] = "red";
  this.colors[1] = "orange";
  this.colors[2] = "darkred";
  this.colors[3] = "gray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.dir = 2;
  setcharani("idle", NULL);
  this.hearts = 0;
}
