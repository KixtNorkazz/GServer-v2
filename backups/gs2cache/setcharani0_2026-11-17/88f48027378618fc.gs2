//#CLIENTSIDE
function onCreated() {
  this.x += .5;
  showcharacter();
  this.attr[1] = "hat-moto-orcwarlord.gif";
  this.head = "val-orcdrummerhead1.gif";
  this.body = "moto-orcbody100.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.dir = 3;
  setcharani("idle", NULL);
  this.hearts = 0;
}
