//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "val-librarian-bookshield.png";
  this.head = "head1355.png";
  this.body = "stragenedit-formal-body102.gif";
  this.colors[0] = "orange";
  this.colors[1] = "brown";
  this.colors[2] = "white";
  this.colors[3] = "brown";
  this.colors[4] = "black";
  setcharani("0", NULL);
  this.nick = "";
  this.dir = 2;
}

function onPlayerEnters() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}

function onPlayerTouchsMe() {
  say2("::He'd glare up at you #b with a smile.:: #b Welcome to the Acedemy sir");
}

function onTimeOut() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}
