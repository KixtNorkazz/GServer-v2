//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_culthead.gif";
  this.body = "val_arwind-racoonbody2.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("val_kneel", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "???";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("Hey! Couldn't you knock first?! Well, while you're here... Did you know that Searith, the Mother of Monsters, lives inside Kharlia?... She could be right beneath our feet!");
  sleep(11);
  message();
}
