//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "ryo250-woodenspearshield.gif";
  this.head = "val-cloakhead.gif";
  this.body = "arwind-kingbody2.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 2;
  this.ap = 100;
}

function onPlayerTouchsMe() {
  say2("Just an old suit of armor");
}
