//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_pride-head9.png";
  this.body = "val_arwind-racoonbody2.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("crossarms", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Wayfarer";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("Esthras is due south of here. I've never seen a city so huge! No wonder it's the capital of the Free Holds.");
  sleep(4);
  message();
}
