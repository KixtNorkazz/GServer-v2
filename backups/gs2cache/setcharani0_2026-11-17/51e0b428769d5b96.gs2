//#CLIENTSIDE
function onCreated() {
  this.x += .5;
  showcharacter();
  this.attr[1] = "hat-valnation-nadrion-knightpaudrons.png";
  this.head = "val-nadrion-valikorliansoldier.png";
  this.body = "nadrion_valikorlian-nation-knighttemplar.gif";
  this.body = "valikorlia-knightbody.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.dir = 2;
  setcharani("idle", NULL);
  this.hearts = 0;
  setcharani("val-bow-idle-red-new", NULL);
  this.body = "valikorlia-knightbody.gif";
}

function onPlayerEnters() {
  setcharani("val-bow-idle-red-new", NULL);
  this.body = "valikorlia-knightbody.gif";
}
