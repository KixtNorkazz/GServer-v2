//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "ryo250-woodenspearshield.gif";
  this.head = "val-arbitrary-head.gif";
  this.body = "arwind-marseillesbody2.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("val-weapon-crossbow_idle", NULL);
  this.dir = 2;
  this.ap = 100;
  this.nick = "";
}

function onPlayerTouchsMe() {
  say2("Welcome to Garriton Castle.");
}
