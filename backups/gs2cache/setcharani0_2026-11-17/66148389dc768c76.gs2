//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_culthead.gif";
  this.body = "val_arwind-racoonbody2.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("val_kneel", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "???";
  this.dir = 0;
}

function onPlayerTouchsMe() {
  message("Boy, this place is spooky.. Speaking of spooky, did you know there used to be a town called Bridgeton south of here? It became infested with giant spiders so somebody blew it up. Watch out for skeletons!");
  sleep(8);
  message();
}
