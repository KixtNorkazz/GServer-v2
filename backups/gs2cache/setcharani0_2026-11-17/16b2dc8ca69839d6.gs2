//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "no-shield.gif";
  this.head = "head5.png";
  this.body = "drakdark-body.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 3;
  this.ap = 100;
  this.nick = "Librarian";
}

function onPlayerTouchsMe() {
  say2("Feel free to browse, but#bplease treat my books with care.#bCome to me if you wish#bto borrow any.");
}
