//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "no-shield.gif";
  this.head = "head7.png";
  this.body = "body.png";
  this.colors[0] = "orange";
  this.colors[1] = "orange";
  this.colors[2] = "orange";
  this.colors[3] = "orange";
  this.colors[4] = "orange";
  setcharani("0", NULL);
  setcharani("dead2", NULL);
  this.dir = 2;
  this.ap = 100;
  this.nick = "";
  drawunderplayer();
}
