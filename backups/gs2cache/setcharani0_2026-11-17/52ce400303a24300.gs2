//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat32.png";
  this.head = "head598.png";
  this.body = "tetsuro-kender-body100.gif";
  this.colors[0] = "yellow";
  this.colors[1] = "red";
  this.colors[2] = "darkbrown";
  this.colors[3] = "red";
  this.colors[4] = "red";
  setcharani("0", NULL);
  setcharani("val_dragaeris-juggle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Whimsy the Clown";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("I'm on the straight and narrow now, I swear! Go ahead and search me if you dare! WOO! That tickles!");
  sleep(4);
  message();
}
