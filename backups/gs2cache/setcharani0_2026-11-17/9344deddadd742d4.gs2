//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "hat.png";
  this.head = "val_pride-head19.png";
  this.body = "val_arwind-smeewnedit-body100.png";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Farmer";
  this.dir = 2;
}

function onPlayerTouchsMe() {
  message("Hail, stranger! We get very few visitors around these parts, but that doesn't mean we're unfriendly!");
  sleep(4);
  message();
}
