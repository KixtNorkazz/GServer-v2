//#CLIENTSIDE
function onCreated() {
  this.x = this.x-.5;
  showcharacter();
  this.attr[1] = "val_hammerforgetanner-hat.gif";
  this.head = "val_tetsuro_dwarfhead2.gif";
  this.body = "val_hammerforgemetalsmith-body100.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Frustrated Dwarf";
  this.dir = 3;
}

function onPlayerTouchsMe() {
  message("I come all this way from the Red Rock Mountains to work with my cousin at this shop. Where in the Hell has he gone off to?!");
  sleep(4);
  message();
}
