//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.attr[1] = "hat-dalmartrooper1.gif";
  this.head = "head0.png";
  this.body = "cythussuirikubody.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.dir = 2;
  setcharani("dead", NULL);
  this.hearts = 0;
  dontblock();
}
