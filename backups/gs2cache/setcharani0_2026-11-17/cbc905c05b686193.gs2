//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showtext(1, this.x+1.78, "y+.55", "Comic Sans MS", "bc", "Templar Knight");
  changeimgzoom(1, .75);
  changeimgvis(2, 2);
}

function onPlayerChats() {
  gs1_always();
  if ((player.chat == "Templar Knight")) {
    player.attr[1] = "hat-lancershoulders.gif";
    player.body = "nadrion_valikorlian-nation-knighttemplar.gif";
    player.head = "nadarionp2p-templarhelmet.gif";
    player.shield = "kaizerscabbard-shield.gif";
  }
}

function gs1_always() {
  showcharacter();
  this.shield = "kaizerscabbard-shield.gif";
  this.attr[1] = "hat-lancershoulders.gif";
  this.head = "nadarionp2p-templarhelmet.gif";
  this.body = "nadrion_valikorlian-nation-knighttemplar.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.dir = 2;
}
