//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.attr[1] = "hat-lancershoulders.gif";
  this.head = "val-nadrion-valikorliansoldier.png";
  this.body = "nadrion_valikorlian-nation-knighttemplar.gif";
  this.body = "valikorlia-knightbody.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shield = "ryo250-woodenspearshield.gif";
  this.shieldpower = 1;
  this.dir = 2;
  this.hearts = 0;
  this.x += .05;
}

function onPlayerChats() {
  if ((player.chat == "fuzzy navel")) {
    hide();
    sleep(1.5);
    show();
  }
}

function onPlayerTouchsMe() {
  say2("Only those permitted may#benter the King's chambers.");
}
