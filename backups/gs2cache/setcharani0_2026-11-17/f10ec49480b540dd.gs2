//#CLIENTSIDE
function onCreated() {
  this.x = this.x+.5;
  showcharacter();
  this.attr[1] = "hat.gif";
  this.head = "val_exhamsoldiery_head100.gif";
  this.shield = "no-shield.gif";
  this.body = "val_exhamsoldiery_body100.gif";
  this.colors[0] = "gray";
  this.colors[1] = "gray";
  this.colors[2] = "white";
  this.colors[3] = "lightgray";
  this.colors[4] = "gray";
  setcharani("0", NULL);
  setcharani("idle", NULL);
  this.swordpower = 1;
  this.shieldpower = 1;
  this.ap = 100;
  this.nick = "Imperial Soldier";
  this.dir = 0;
}
