//#CLIENTSIDE
function onCreated() {
  gs1_always();
}

function gs1_always() {
  if (this.actionOpen) {
    if (this.w==16*8) {
      dontblock();
      this.m = 1;
    } else {
      this.m = 2;
    }
  }
}

function onCreated() {
  this.img = "shiridian-gate1.gif";
  this.alpha = 0;
  setshape(1, 16*8, 16*7);
  this.w = 16*8;
  showimg(1, "this.img", this.x, this.y);
  changeimgpart(1, 0, 0, 16*4, 16*7);
  showimg(2, "this.img", this.x+4, this.y);
  changeimgpart(2, 16*4, 0, 16*4, 16*7);
  changeimgvis(1, 1);
  changeimgvis(2, 1);
}

function onTimeout() {
  showimg(1, "this.img", this.x, this.y);
  changeimgpart(1, 16*4-this.w/2, 0, this.w/2, 16*7);
  showimg(2, "this.img", this.x+4+(4-(this.w/32)), this.y);
  changeimgpart(2, 16*4, 0, this.w/2, 16*7);
  if (this.m==1) {
    if (this.w>=8) {
      this.w -= 4;
    } else {
      hideimg(1);
      hideimg(2);
    }
  } else if (this.m==2) {
    if (this.w<=(16*8-4)) {
      this.w += 4;
    } else {
      blockagain();
    }
  }
  changeimgvis(1, 1);
  changeimgvis(2, 1);
}
