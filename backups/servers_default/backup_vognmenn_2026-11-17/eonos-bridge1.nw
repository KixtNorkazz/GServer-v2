//#CLIENTSIDE
function onCreated() {
  emit();
}
function emit(){
 with (findimg(200)) {
    // Shadow

    // Emitter attributes
    layer = 1;
    emitter.delaymin = 0.05;
    emitter.delaymax = 0.05;
    emitter.nrofparticles = 2;
    emitter.firstinfront = false;
    emitter.emissionoffset = {0.1, -.25, 0.3};

    // Basic particle attributes
    emitter.particle.lifetime = 0.4;
    emitter.particle.image = "g4_animation_fire.gif";

    // Color
    emitter.particle.alpha = 0.3;
    emitter.particle.zoom = .3;
    emitter.particle.mode = 2; // subtract

    // Movement
    emitter.particle.angle = pi / 2;
    emitter.particle.speed = 4;
    emitter.addlocalmodifier("once", 0, 0, "angle", "add", -0.1, 0.1);
    emitter.addlocalmodifier("once", 0, 0, "x", "add", -0.3, 0.3);
    emitter.addlocalmodifier("range", 0, 0.6, "alpha", "replace", 0.3, 0);
    emitter.addlocalmodifier("range", 0, 0.2, "zoom", "replace", .5, 1);
    emitter.addlocalmodifier("range", 0.2, 0.4, "zoom", "replace", 1, .5);
    emitter.addlocalmodifier("range", 0, 0.6, "speed", "replace", 4, 8);
  }

  with (findimg(201)) {
    // Fire

    // Emitter attributes
    layer = 2;
    emitter.delaymin = 0.05;
    emitter.delaymax = 0.05;
    emitter.nrofparticles = 2;
    emitter.firstinfront = false;
    emitter.emissionoffset = {0.1, -.25, 0};

    // Basic particle attributes
    emitter.particle.lifetime = 0.4;
    emitter.particle.image = "g4_animation_fire.gif";

    // Color
    emitter.particle.red = 1;
    emitter.particle.green = 0.5;
    emitter.particle.blue = 0.5;
    emitter.particle.alpha = 0.4;
    emitter.particle.zoom = .1;
    emitter.particle.mode = 0; // add like a light

    // Movement
    emitter.particle.angle = pi / 2;
    emitter.particle.speed = 4;
    emitter.addlocalmodifier("once", 0, 0, "angle", "add", -0.1, 0.1);
    emitter.addlocalmodifier("once", 0, 0, "x", "add", -.2, .5);
    emitter.addlocalmodifier("range", 0, 0.4, "alpha", "replace", 0.4, 0);
    emitter.addlocalmodifier("range", 0, 0.2, "zoom", "replace", .35, .85);
    emitter.addlocalmodifier("range", 0.2, 0.4, "zoom", "replace", .85, 1.25);
    emitter.addlocalmodifier("range", 0, 0.4, "speed", "replace", 4, 8);
  }
}
