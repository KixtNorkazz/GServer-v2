  this.changeRate = .01;//CAN NOT BE 0
  this.maxMovements = .15;//in y
  this.stepc = 0;
  setTimer(.1);
}
function onTimeout()
{
  //setcharani("idle","idle");
  y += this.changeRate;
  if (this.changeRate > 0)
  {
    this.stepc += this.changeRate;
  }else if (this.changeRate < 0)
  {
    this.stepc += (this.changeRate * -1);
  }
  if (this.stepc > this.maxMovements)
  {
    this.changeRate *= -1;
    this.stepc = 0;
  }
  setTimer(.1);
}

