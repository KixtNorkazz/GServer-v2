NPC val_irongate.gif 62 33
if (created) {
  dontblock;
  this.gate = 0;
  this.gate2 = 0;
}
if (playerchats) {
  if (strequals(#g,Greendale)) {
    if (strequals(#c,/Close Gates)) {
      if (this.gate == 0 && this.gate2 == 0 && this.gate3 == 0) {
        this.gate = 1;
        this.gate2 = 1;
        move 0,+3,1.5,0;
        sleep 1.5;
        this.gate2 = 0;
        blockagain;
        drawunderplayer;
      }
    }
    if (strequals(#c,/Open Gates)) {
      if (this.gate == 1 && this.gate2 == 0) {
        this.gate = 0;
        this.gate2 = 1;
        if (this.gate3 == 1) {
          this.gate3 = 0;
          move +7,0,2.5,0;
          sleep 2.5;
        }
        else {
          move 0,-3,1.5,0;sleep 1.5;
        }
        this.gate2 = 0;
        dontblock;
      }
    }
  }
}
if (movementfinished) {
  this.moving=0;
}
NPCEND
