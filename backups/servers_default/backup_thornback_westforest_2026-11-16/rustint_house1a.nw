function onCreated()
{
this.loopSpeed=0.05;
setTimer(this.loopSpeed);
}
function onTimeout()
{
if (this.night==true)
seteffect(0,0,0,.25);
else
seteffect(0,0,0,0);
setTimer(this.loopSpeed);
}
function onPlayerchats()
{
if (player.chat=="Day")
this.night=false;
else if(player.chat=="Night")
this.night=true;
}
