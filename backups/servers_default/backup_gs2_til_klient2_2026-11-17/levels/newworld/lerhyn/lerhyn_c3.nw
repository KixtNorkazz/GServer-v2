function onCreated()
  {
  showcharacter();
  dontblock();
  nick = "Beverly";
  headimg = "val-alesterahead3.gif";
  bodyimg = "valp_theblindone_body116.gif";
  shieldimg = "no-shield.gif";
  dir = 0;
  setcharani("idle","idle");
  setTimer(.1);
}
function onTimeout()
  {
  this.rtime = random(.25,4);
  this.rm = int(random(1,5));
  if (this.rm > 1)
    {
    setcharani("idle","idle");
  }
  else
    {
    setcharani("raisehands1","raisehands1");
    message("This is incredible!");
    sleep 1;
    message(" ");
  }
  setTimer(this.rtime);
}
