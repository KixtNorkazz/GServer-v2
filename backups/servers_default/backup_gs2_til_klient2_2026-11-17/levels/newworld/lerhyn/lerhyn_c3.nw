// (the GS2 code that stood here was moved to the client part on 17 Nov 2026)
//#CLIENTSIDE
function onCreated() {
  nick = "Peddler";
  showcharacter();
  dontblock();
  headimg = "val_johnnyspond-aralhead.gif";
  bodyimg = "val-naisrep-body100.gif";
  dir = 2;
  setcharani("lift","lift");
  setTimer(.1);
}
function onTimeout() {
  this.rtime = random(.25,5);
  this.rdir = int(random(1,4));
  this.rm = int(random(1,4));

  if (this.rdir < 3)
    {
    dir = this.rdir;
  }
  else
    {
    dir = 3;
  }
  if (this.rm == 1)
  {
     message("Show your true love your feelings with an engraved water canteen!");
     sleep(1);
  }
  else if (this.rm == 2)
  {
     message("Water, cheap!");
     sleep(1);
  }
  else if (this.rm == 3)
  {
     message("Fresh from the river!");
     sleep(1);
  }
  else if (this.rm >= 0)
  {
     message("Lowest prices around!");
     sleep(.5);
  } else { message("SHT ERROR..brb.."); }

  setTimer(this.rtime);
}
