// NPC made by Dylan
//#CLIENTSIDE
function onCreated() {
  this.message("Job - Alchemy");
}
function onPlayerChats() {
  if(player.chat == "/showalchemyitems") {
    if(clientr.alchemy_items.size() > 0) {
      this.showItems();
    }
    else {
      onCreated();
    }
  }
}
function onActionRightMouse() {
  JobAlchemy.createContextMenu();
  AlchemyContextMenu.openatmouse();
}
function showItems() {
  for(temp.i = 0; temp.i < clientr.alchemy_items.size(); temp.i++) {
    temp.message @= clientr.alchemy_items[temp.i] @ "(" @ clientr.alchemy_amts[temp.i] @ "), ";
  }
  this.message(temp.message);
}
