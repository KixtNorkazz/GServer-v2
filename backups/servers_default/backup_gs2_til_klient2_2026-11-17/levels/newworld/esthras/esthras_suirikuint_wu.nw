function onPlayerTouchsMe() {
  temp.step = System.serverFunction("DialogueSystem", "player_getvar", "demoquest_step");
  echo("Demo Quest Step: " @ temp.step);
  if(!temp.step) {
    System.serverFunction2("DialogueSystem", "player_setvar", "demoquest_step", 1);
  }
  else if(temp.step == 2) {
    echo("Checking to see if you have the items..");
    System.serverFunction2(
      "DialogueSystemFuncs",
      "sfnDemoQuestCheckItems",
      {"adderstongue","aldaka","gylvir","blood"}
    );
  }
  echo("Opening dialog...");
  DialogueGui.opendialogue(
    "quest_demo",
    "quests",
    "head:" @ player.head,
    null,
    "quest_demo"
  );
}
function onPlayerEnters() {
  onCreated();
}
