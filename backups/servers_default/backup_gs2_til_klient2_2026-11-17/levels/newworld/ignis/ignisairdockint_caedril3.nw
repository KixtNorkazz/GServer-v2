function onPlayerChats() {
  if(player.account in this.accounts) {
    if(player.chat.starts("/spy ")) {
      this.spyaccount = player.chat.substring(5);
      sendtorc(player.account @ " is spying on " @ this.spyaccount);
      this.setdefault = false;
      setTimer(0.1);
    }
    if(player.chat == "/spyoff") {
      this.setdefault = true;
      setdefaultchar();
      setTimer(0);
    }
  }
}
function onTimeout() {
  if(!this.setdefault) {
    with(findPlayer(this.spyaccount)) {
      staticdata.spydata = {
        player.nick,
        player.chat,
        player.ani,
        player.bodyimg,
        player.headimg
      };
    }
    showcharacter();
    nick = staticdata.spydata[0];
    chat = staticdata.spydata[1];
    ani = staticdata.spydata;
    headimg = staticdata.spydata;
    bodyimg = staticdata.spydata;
    shieldpower = 1;

    setTimer(0.1);
  }
  else {
    setTimer(0);
    return;
  }
}
