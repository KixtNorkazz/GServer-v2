NPC bridgeton-porticullis.gif 8 25
function onCreated() {
  if(this.open == 1) {
    setimgpart("bridgeton-porticullis.gif",0,54,64,80);
  }
  else {
    setimgpart("bridgeton-porticullis.gif",0,0,64,80);
  }
  drawoverplayer();
  this.permissions = {
    "LoneAngelIbesu",
    "royalsea3",
    "hairballmunky",
    "ssj2sal"
  };
}
function onPlayerChats() {
  temp.i = 0;
  if(player.account in this.permissions) {
    if(player.chat == "/open 1") {
      for(i=0; i < 55; i++) {
        setimgpart("bridgeton-porticullis.gif",0,i,64,80);
        sleep(0.1);
      }
      dontblock();
      this.open = 1;
    }
    if(player.chat == "/close 1") {
      for(i=54; i > -1; i--) {
        setimgpart("bridgeton-porticullis.gif",0,i,64,80);
        sleep(0.1);
      }
      blockagain();
      this.open = 2;
    }
  }
}
NPCEND
