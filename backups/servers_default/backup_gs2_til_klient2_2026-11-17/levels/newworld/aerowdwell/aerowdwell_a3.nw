function onPlayertouchsme()
  {
  if (this.saying == 0)
    {
    this.saying = 1;

    this.rm = int(random(1,10));
    if (this.rm == 1)
      {
      message("T'days shipment be goin' well! The return to the west'll will begin shortly. [Speak 'West' to shove off]");
    }else if (this.rm > 1 && this.rm < 5)
        {
      message("The seas be calm t'day. Say the word.[Speak 'West' to shove off]");
    } else if (this.rm >= 5)
        {
      message("Welcome to me ship! Headin' west?. [Speak 'West' to shove off]");
    }

    sleep(2);
    message(" ");
    this.saying = 0;
  }
}
