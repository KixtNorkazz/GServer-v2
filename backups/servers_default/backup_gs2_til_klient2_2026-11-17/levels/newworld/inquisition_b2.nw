//#CLIENTSIDE
function onCreated() {
  showcharacter();
  nickname = "Inquisitorial Guard";
  headimg = "heroicmatt-nicholai.gif";
  bodyimg = "val-inquisitorbymoto-body102.gif";
  shieldimg = "no-shield.png";
  sheildpower = 1;
  dir = 2;
}

function onPlayerTouchsMe() {
  say2("This land was purchased under" NL "the old monarchy. The High" NL "Inquisitor retained the rights" NL "when he was found innocent.");
}

function onPlayerEnters() {
  setTimer(random( 2, 5 ));
}

function onTimeout() {
  setcharani("idle", "idle");
  this.randomx = int(random( -2, 2 ));
  this.randomy = int(random( -2, 2 ));

  if (!onwall(x+1.5*this.randomx,y+2*this.randomy)) {
    if (!onwater(x+1.5*this.randomx,y+2*this.randomy)) {
      move(this.randomx,this.randomy,1,4+8+16+32);
      setcharani("walk","walk");
    }
  }

  sleep(1);
  setcharani("idle", "idle");
  setTimer(random(2,5));
}
NPCEND
