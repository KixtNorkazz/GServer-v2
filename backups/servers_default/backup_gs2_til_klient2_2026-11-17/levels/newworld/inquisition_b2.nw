function onCreated(){
  this.allowed = {
    "LoneAngelIbesu",
    "BlackWolf777"
  };
}
function onPlayerChats() {
  if (player.account in this.allowed) {
    if (player.chat == "open") {
      System.playlevel("chubby-GateOpen.wav", player.level);

      temp.i = 0;
      for (i=0; i < 65; i++) {
        sleep(0.05);
        setimgpart("valikorlia_irongate.gif",0,i,128,96);
      }
      dontblock();
      drawoverplayer();
    }
    if (player.chat = "close") {
      System.playlevel("chubby-GateOpen.wav", player.level);
      temp.i = 0;
      for (i=64; i > -1; i--) {
        sleep(0.05);
        setimgpart("valikorlia_irongate.gif",0,i,128,96);
      }
      blockagain();
      drawunderplayer();
    }
  }
}
