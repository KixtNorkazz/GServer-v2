//#CLIENTSIDE
function onPlayerChats() {
  if (player.chat == "morning") {
    seteffect(0, 0.05, 0.1, 0.25);
  }
  if (player.chat == "midday") {
    seteffect(0, 0, 0, 0);
  }
  if (player.chat == "afternoon") {
    seteffect(0.075, 0.05, 0, 0.15);
  }
  if (player.chat == "evening") {
    seteffect(0, 0.05, 0.1, 0.5);
  }
  if (player.chat == "night") {
    seteffect(0, 0, 0, 0.7);
  }
}
