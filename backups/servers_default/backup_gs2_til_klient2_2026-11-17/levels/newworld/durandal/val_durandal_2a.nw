function onPlayertouchsme()
  {
  if (this.saying == 0)
    {
    this.saying = 1;

    this.rm = int(random(1,10));
    if (this.rm == 1)
      {
      message("The Arrow is ready to shove off at any time. [Speak 'Lucca' or 'Ignis' or 'Gatling Flats' to shove off]");
    }else if (this.rm > 1 && this.rm < 5)
        {
      message("The Arrow is ready to shove off at any time. [Speak 'Lucca' or 'Ignis' or 'Gatling Flats' to shove off]");
    } else if (this.rm >= 5)
        {
      message("The Arrow is ready to shove off at any time. [Speak 'Lucca' or 'Ignis' or 'Gatling Flats' to shove off]");
    }

    sleep(2);
    message(" ");
    this.saying = 0;
  }
}
