setimgpart("val_dragaeris-airshiptable.png",0,0,16,32);
}

function onPlayerChats() {
if (player.account == "Spit_Fire99" || player.account == "Trooper43G" || player.account == "fullmetalfan" || player.account == "KaroAurionRoamer") {
if (player.chat == "/unlock") {
this.door = 1;
}
if (player.chat == "/lock") {
this.door = 0;
}
if (player.chat = "/open") {
hide;
}
if (player.chat = "/close") {
show;
}
}
}

function onPlayerTouchsme() {
if (this.door = 1) {
hide;
sleep(5);
show;
}
if (player.account == "Spit_Fire99" || player.account == "Trooper43G" || player.account == "fullmetalfan" || player.account == "kirby677" || player.account == "KaroAurionRoamer" || player.account == "sniperjoe10" || player.account == "SRA_Link" || player.account == "darknikky" || player.account == "j0rd1e1") {
if (this.door = 0) {
hide;
sleep(5);
show;
}
}
}
NPCEND
