NPC - 35 10
function onCreated() {
  setshape 1,64,16;
  this.w = 64;
  showimg(1,"bridgeton-porticullis.gif",x,y-3);
  changeimgpart(1,0,0,64,64);
  changeimgvis 1,1;
}
function onActionLeftMouse() {
  if (this.w==64) {
    dontblock();
    this.m = 1;
    this.setTimer(.05);
  }
  else {
    blockagain();
    this.m = 2;
    this.setTimer(.05);
  }
}
function onTimeout() {
  showimg(1,"bridgeton-porticullis.gif",x,y-3);
  changeimgpart(1,0,64-this.w,64,this.w);
  if (this.m==1) {
    if (this.w>=8) {
      this.w -= 4;
    }
    else {
      hideimg(1);
      this.m==0;
    }
  }
  else if (this.m==2) {
    if (this.w<=60) {
      this.w += 4;
    }
    else {
      this.m==0;
    }
  }
  this.setTimer(.05);
  changeimgvis 1,1;
}
//#CLIENTSIDE
function onCreated() {
  setshape 1,64,16;
}
NPCEND
