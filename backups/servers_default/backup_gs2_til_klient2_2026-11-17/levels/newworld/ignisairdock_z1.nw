function onPlayertouchsme()
  {
  if (this.saying == 0)
    {
    this.saying = 1;

    this.rm = int(random(1,10));
    if (this.rm == 1)
      {
      message("The Embersage is ready to shove off at any time. [Speak 'Durandal' to shove off]");
    }else if (this.rm > 1 && this.rm < 5)
        {
     message("The Embersage is ready to shove off at any time. [Speak 'Durandal' to shove off]");
    } else if (this.rm >= 5)
        {
      message("The Embersage is ready to shove off at any time. [Speak 'Durandal' to shove off]");
    }

    sleep(2);
    message(" ");
    this.saying = 0;
  }
}
