if (player.dir == 0) {dir = 2;}
if (player.dir == 1) {dir = 3;}
if (player.dir == 2) {dir = 0;}
if (player.dir == 3) {dir = 1;}
chat = "Ugh. That new expansion on the next floor is going awful. That's what you get when you don't use Griff.";
