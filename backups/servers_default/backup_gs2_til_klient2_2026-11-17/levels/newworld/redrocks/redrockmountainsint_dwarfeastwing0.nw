NPC - 38 4
// NPC made by Dr. Zectra
function onCreated()
{
  setshape(1,16,96);
  this.sourceXY = {this.x, this.y};
  this.sImg = "val-hammerforge-smallgate-bysam.gif";
  this.open = false;
  setimgpart(this.sImg,32,0,3,96);
  dontblock();
}

function onPlayertouchsme()
{
  if (!this.open)
  {
    this.open = true;
    if (player.dir == 1)
    {
      setimgpart(this.sImg,32,0,32,96);
      this.x = this.sourceXY[0] - 2;
    }
    else if (player.dir == 3)
    {
      setimgpart(this.sImg,0,0,32,96);
    }
    sleep(1);
    setimgpart(this.sImg,32,0,3,96);
    this.x = this.sourceXY[0];
    this.y = this.sourceXY[1];
    this.open = false;
  }
}
