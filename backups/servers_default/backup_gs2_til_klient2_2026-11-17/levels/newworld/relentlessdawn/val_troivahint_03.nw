    if (this.w>=8) {
      this.w -= 8;
    }
    else {
      hideimg(1);
      this.m==0;
    }
  }
  else if (this.m==2) {
    if (this.w<=(104)) {
      this.w += 8;
    }
    else {
      this.m==0;
    }
  }
  this.setTimer(.05);
  changeimgvis 1,1;
