//#CLIENTSIDE
function onCreated() {
  gs1_always();
  setshape(1, 64, 64);
  dontblock();
  this.mode = 1;
  drawunderplayer();
  message();
  setTimer(0.05);
}

function onPlayerEnters() {
  gs1_always();
  drawunderplayer();
}

function onTimeOut() {
  gs1_always();
  hide();
  if (("#f" == "clash-hole1.gif")) {
    noise();
    setcoloreffect(1, 1, 1, 1);
    if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    } else {
      hideimg(1);
    }
    message("*Szh*");
    if (this.mode==0) {
      this.mode = 1;
      sleep(0.02);
      sleep(1);
      hideimg(2);
    }
    this.dir = 2;
    play("val_monolithpulse1.wav");
    triggeraction(this.x+1.5+vecx(0)*2, this.y+2+vecy(0)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(1)*2, this.y+2+vecy(1)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(2)*2, this.y+2+vecy(2)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(3)*2, this.y+2+vecy(3)*2, "plague", player.account);
    setTimer(0.05);
  } else if (("#f" == "clash-hole2.gif")) {
    noise();
    setcoloreffect(1, 1, 1, 1);
    if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    } else {
      hideimg(1);
    }
    message("*Ssszh*");
    if (this.mode==0) {
      this.mode = 1;
      sleep(0.02);
      sleep(1);
      hideimg(2);
    }
    this.dir = 2;
    play("val_monolithpulse2.wav");
    triggeraction(this.x+1.5+vecx(0)*2, this.y+2+vecy(0)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(1)*2, this.y+2+vecy(1)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(2)*2, this.y+2+vecy(2)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(3)*2, this.y+2+vecy(3)*2, "plague", player.account);
    setTimer(0.05);
  } else if (("#f" == "clash-hole3.gif")) {
    noise();
    setcoloreffect(1, 1, 1, 1);
    if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    } else {
      hideimg(1);
    }
    message("*Ssszzhh*");
    if (this.mode==0) {
      this.mode = 1;
      sleep(0.02);
      sleep(1);
      hideimg(2);
    }
    this.dir = 2;
    play("val_monolithpulse3.wav");
    triggeraction(this.x+1.5+vecx(0)*2, this.y+2+vecy(0)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(1)*2, this.y+2+vecy(1)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(2)*2, this.y+2+vecy(2)*2, "plague", player.account);
    triggeraction(this.x+1.5+vecx(3)*2, this.y+2+vecy(3)*2, "plague", player.account);
    setTimer(0.05);
  } else if (("#f" == "clash-seal2.gif")) {
    setcoloreffect(1, 1, 1, .80);
    if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    } else {
      hideimg(1);
    }
    message("*Sealed.. for now*");
    if (this.mode==1) {
      play("bug-whistle8.wav");
      this.mode = 0;
      sleep(0.5);
      hideimg(2);
    }
    this.dir = 2;
    play("val_monolithpulse1.wav");
    setTimer(0.05);
  } else if (("#f" == "clash-sealweak2.gif")) {
    if (player.x in |this.x-5,this.x+5| && player.y in |this.x-5,this.x+5|) {
    }
    setcoloreffect(1, 1, 1, .50);
    message("*Sealed.. for now*");
    this.dir = 2;
    play("val_monolithpulse1.wav");
    setTimer(0.05);
    if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    } else {
      hideimg(1);
    }
  } else if (("#f" == "clash-sealpermasuper3.gif")) {
    setcoloreffect(1, 1, 1, .80);
    message("*Sealed..*");
    if (this.mode==1) {
      play("bug-whistle8.wav");
      this.mode = 0;
      sleep(0.5);
      hideimg(2);
    }
    this.dir = 2;
    play("bug-whistle8.wav");
    triggeraction(this.x+1.5+vecx(0)*2, this.y+2+vecy(0)*2, "plaguehealed1", this.agh);
    triggeraction(this.x+1.5+vecx(1)*2, this.y+2+vecy(1)*2, "plaguehealed1", this.agh);
    triggeraction(this.x+1.5+vecx(2)*2, this.y+2+vecy(2)*2, "plaguehealed1", this.agh);
    triggeraction(this.x+1.5+vecx(3)*2, this.y+2+vecy(3)*2, "plaguehealed1", this.agh);
    setTimer(0.05);
    if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    } else {
      hideimg(1);
    }
  }
}

function gs1_always() {
  if (this.actiondestroy) {
    this.destroy = 1;
  }
}

function hide() {
  if (player.x in |this.x-10,this.x+10| && player.y in |this.y-10,this.y+10|) {
    show();
  } else {
    hide();
  }
}

function noise() {
  if (player.x in |this.x-2,this.x+2| && player.y in |this.y-2,this.y+2|) {
    play("kappa_chubby.wav");
    if (!client.primerr&&hasweapon(*this.Runes/this.Seal this.Primer)) {
      client.primerr = 1;
      say2("The primer rune glows.");
    }
    if (!client.primerx&&hasweapon(*this.Runes/this.Seal this.Primer this.X)) {
      client.primerx = 1;
      say2("The primer rune glows.");
    }
    this.random = random(0, 100);
    if (!hasweapon(*this.Runes/this.Plagueguard this.Rune)) {
      triggeraction(0, 0, "serverside", -!this.Temp-this.System, this.minushp, 1);
      if (this.random>10&&hasweapon(*this.Runes/this.Wisp this.Catcher this.Rune)) {
        say2("You caught a wisp in your rune!!");
        play("chest.wav");
        triggeraction(0, 0, "serverside", -!this.Temp-this.System, this.rune, *this.Runes/this.Wisp this.Catcher this.Rune, 1);
        triggeraction(0, 0, "serverside", -!this.Temp-this.System, this.addwisp);
      }
    } else if (hasweapon(*this.Runes/this.Plagueguard this.Rune)) {
      if (this.random>10&&hasweapon(*this.Runes/this.Wisp this.Catcher this.Rune)) {
        say2("You caught a wisp in your rune!!");
        play("chest.wav");
        triggeraction(0, 0, "serverside", -!this.Temp-this.System, this.rune, *this.Runes/this.Wisp this.Catcher this.Rune, 1);
        triggeraction(0, 0, "serverside", -!this.Temp-this.System, this.addwisp);
      }
      play("bug-whistle1.wav");
      play("bug-whistle2.wav");
      triggeraction(0, 0, "serverside", -!this.Temp-this.System, this.rune, *this.Runes/this.Plagueguard this.Rune, 1);
      sleep(0.08);
      hideimg(2);
    }
  }
}
