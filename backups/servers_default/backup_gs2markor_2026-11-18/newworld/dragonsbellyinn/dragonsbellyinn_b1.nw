function onCreated()
{
  this.showcharacter();
  this.headimg = "val_smeewn_dwarf_head8.gif";
  this.bodyimg = "arwind-smeewnedit-body100.png";
  this.attr[1] = "hat54.png";
  //this.shield = "shield1.gif";
  //this.colors[0] = "orange";
  //this.colors[1] = "white";
  //this.colors[2] = "blue";
  //this.colors[3] = "red";
  //this.colors[4] = "black";
  this.setcharani("idle", null);
  this.dir = 2;
  this.nick = "Fisherman";
  this.chat = "Come ove' er'. Got sum' spare fishin' sticks.";
}

function onPlayerTouchsme()
{
  if (timevar2 < this.lastTouched + 1) return;
  this.lastTouched = timevar2;
  
  temp.currentRodCount = player.mud.countitem("fishingrod", false);
  
  if (temp.currentRodCount < 1) {
    player.mud.additem("fishingrod", 1);
    Messages.addmsg(3, "You get a free fishing rod!");
  }
  else {
    Messages.addmsg(3, "You already have " @ temp.currentRodCount @ " fishing rod" @ (player.mud.fishingrod > 1 ? "s" : "") @ "!");
  }
}
NPCEND
