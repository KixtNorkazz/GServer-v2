NPC val_fishingrodprop.gif 44 51
function onPlayerTouchsme()
{
  if (timevar2 < this.lastTouched + 1) return;
  this.lastTouched = timevar2;

  temp.currentRodCount = player.mud.countitem("fishingrod", false);

  if (temp.currentRodCount < 1) {
    player.mud.additem("fishingrod", 1);
    Messages.addmsg(3, "You found an abandoned fishing rod!");
  }
  else {
    Messages.addmsg(3, "You've already found " @ temp.currentRodCount @ " fishing rod" @ (player.mud.fishingrod > 1 ? "s" : "") @ "!");
  }
}
