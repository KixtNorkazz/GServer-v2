function onPlayerTouchsme()
{
  if (timevar2 < this.lastTouched + 2) return;
  this.lastTouched = timevar2;

  temp.currentElfswordCount = player.mud.countitem("elftrainingsword", false);

  if (temp.currentElfswordCount < 1) {
    player.mud.additem("elftrainingsword", 1);
    Messages.addmsg(3, "You found a bronzewood training sword!");
  }
  else {
    Messages.addmsg(3, "You've already found this weapon!");
  }
}
