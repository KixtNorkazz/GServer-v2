function onPlayerTouchsme()
{
  if (timevar2 < this.lastTouched + 2) return;
  this.lastTouched = timevar2;

  temp.currentElfbowCount = player.mud.countitem("elfbow2", false);

  if (temp.currentElfbowCount < 1) {
    player.mud.additem("elfbow2", 1);
    Messages.addmsg(3, "You found an elven longbow!");
  }
  else {
    Messages.addmsg(3, "You've already found this bow!");
  }
}
