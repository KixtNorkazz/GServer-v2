NPC val_fog.png 56 54
//FORWARD >
//#CLIENTSIDE
function onCreated()
{
  setcoloreffect(1,1,1,.99);
  setzoomeffect(3);
  drawaslight();
  dontblock();

  this.maxMove = this.x + 5;

  this.defaultX = this.x;
  this.moveInc = .05;
  this.loopSpeed = .2;

  setTimer(.05);
}

function onTimeout()
{
  if (this.CountDown <= 0)
  {
    this.CountDown = 0;
    this.x += this.moveInc;


    if (this.x > this.maxMove || this.x < this.defaultX)
    {
      this.moveInc*=-1;
      this.CountDown = .5;
    }
  }
  else
  {
    this.CountDown -= this.loopSpeed;
  }

  setTimer(this.loopSpeed);
}
NPCEND
