NPC val-springtrap.gif 22 26
//#CLIENTSIDE
if (created)
{
  setimgpart val-springtrap.gif,0,0,48,2;

  this.triggerAtX = 17;
  //this.triggerAtY = y;
  this.cwidth = 48;
  this.chieght = 64;

  this.cy = y;
  this.trapset = 0;

  timeout = .1;
}

if (playerchats && this.trapset == 1)
{
  if (strequals(#c,reset traps) && strequals(#g,The Wayward))
  {
    hideTrap();
  }
}

if (timeout)
{
  if (playerx <= this.triggerAtX && this.trapset == 0)
  {
     if (strequals(#g,The Wayward))
     {
       message ;
     }else{springTrap();}
  }
  timeout = 0.1;
}

function springTrap()
{
  this.trapset = 1;
  for (this.i=1; this.i < 96; this.i+=16)
    {
    y -= .5;
    setimgpart val-springtrap.gif,0,0,this.cwidth,this.i;
    sleep(.05);
  }
  timeout = .1;
}

function hideTrap()
{
  this.trapset = 0;
  for (this.i = 0; this.i < 64; this.i++)
    {
    setimgpart val-springtrap.gif,0,0,this.cwidth,this.chieght-this.i;
    y += .05;
    sleep(.05);
  }
  setimgpart val-springtrap.gif,0,0,48,2;
  y = this.cy;
  timeout = .1;
}
NPCEND
