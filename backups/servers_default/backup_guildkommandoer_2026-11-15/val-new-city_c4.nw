NPC val_nombarg_fix.gif 48 42
//#CLIENTSIDE
dontblock;
drawunderplayer;

//serverside gatescript by mido :O

if (created) {
  canwarp;
  canwarp2;
  this.open=0;  // dont touch :O
  this.moving=0; //this will be what will make sure players cant do OPEN GATE like 30 times
  this.move=4; //Will move negative seven (negative = left  positive = right)
  this.movespeed=abs(this.move/2); //the speed (For this I put move variable, divided by 2, to give it a more dynamic effect)
  setstring this.guild,The Valikorlian Empire; // The guild it opens for
}

if (playerchats&&strequals(#s(this.guild),#g)) {
  if (strequals(#c,/open gates)&&this.open==0&&this.moving==0) {
    this.moving=1;
    this.open=1;
    move this.move,0,this.movespeed,8;
  }
  if (strequals(#c,/close gates)&&this.open==1&&this.moving==0) {
    this.moving=1;
    this.open=0;
    move this.move*-1,0,this.movespeed,8;
  }
}

if (movementfinished) {
  this.moving=0
}
NPCEND
