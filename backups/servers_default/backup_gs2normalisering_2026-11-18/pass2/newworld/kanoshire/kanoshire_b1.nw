NPC val_doordark.gif 16 27
// Rentable house door, GS1 version (17 Nov 2026): world_housingsystem_door did this in GS2 server code, which this server does not run.
// Owner saved in the server flag server.house_newbrookhurstint_house1_1. Next to the door: /open, /close (owner or staff), /owner, /rentto <account> (staff),
// /clearowner (owner or staff). Staff here: Kixt, KixtNorkazz. An open door lets everyone in; it closes 2 s after the owner went in.
join("world_housingsystem_door");
if (created) {
  this.open = 0;
  setimg val_doordark.gif;
}
if (playertouchsme && this.open == 1) {
  setlevel2 newbrookhurstint_house1-1.nw,39.5,32.9;
  if (strequals(#a,#s(server.house_newbrookhurstint_house1_1))) {
    sleep 2;
    this.open = 0;
    setimg val_doordark.gif;
  }
}
if (playertouchsme && this.open == 0 && strlen(#s(server.house_newbrookhurstint_house1_1)) == 0) {
  message This house is for rent. Talk to a staff member.;
  sleep 2;
  message ;
}
if (playerchats && abs(playerx - x) < 4 && abs(playery - y) < 4) {
  this.staff = 0;
  if (strequals(#a,Kixt) || strequals(#a,KixtNorkazz)) {
    this.staff = 1;
  }
  this.owner = 0;
  if (strlen(#s(server.house_newbrookhurstint_house1_1)) > 0 && strequals(#a,#s(server.house_newbrookhurstint_house1_1))) {
    this.owner = 1;
  }
  if (strequals(#c,/owner)) {
    if (strlen(#s(server.house_newbrookhurstint_house1_1)) > 0) {
      message Owner: #s(server.house_newbrookhurstint_house1_1);
    } else {
      message For rent;
    }
  }
  if ((this.owner == 1 || this.staff == 1) && strequals(#c,/open)) {
    this.open = 1;
    setimg val_doordarkopen.gif;
  }
  if ((this.owner == 1 || this.staff == 1) && strequals(#c,/close)) {
    this.open = 0;
    setimg val_doordark.gif;
  }
  if ((this.owner == 1 || this.staff == 1) && strequals(#c,/clearowner)) {
    setstring server.house_newbrookhurstint_house1_1,;
    this.open = 0;
    setimg val_doordark.gif;
    message For rent;
  }
  if (this.staff == 1) {
    tokenize #c;
    if (tokenscount == 2 && strequals(#t(0),/rentto)) {
      setstring server.house_newbrookhurstint_house1_1,#t(1);
      message Rented to #t(1);
    }
  }
}
//#CLIENTSIDE
function onCreated(){
  // from the server part (GS2, which the server does not run)
this.exit = {"newbrookhurstint_house1-1.nw",39.5,32.9};

this.uniqueDoorIdentifier = "newbrookhurstint_house1-1";
}
