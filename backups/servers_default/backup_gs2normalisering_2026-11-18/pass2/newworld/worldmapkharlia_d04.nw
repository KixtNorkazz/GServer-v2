        emitter.nrofparticles = 1;
        emitter.emissionoffset = {0, 0, 1};
        emitter.checkbelowterrain = true;
        emitter.cliptoscreen = false;
        emitter.wraptoclippingbox = true;
        emitter.particle.image = "val_particle_snowflake.png";
        emitter.particle.lifetime = 3;
        emitter.particle.zangle = -1;
        emitter.particle.speed = 0.5;
        emitter.particle.alpha = 0.2;
        emitter.addglobalmodifier("impulse", 0.2, 0.2, "zangle", "multiply", 0.95, 0.95);
        emitter.addlocalmodifier("once", 0, 0, "rotation", "replace", 0, 2*pi);
        emitter.addlocalmodifier("once", 0, 0, "angle", "replace", degtorad(300), degtorad(220)); //200,260
        emitter.addlocalmodifier("once", 0, 0, "x", "add", -3 , 3 );
        emitter.addlocalmodifier("once", 0, 0, "y", "add", -5 , 5 );
        emitter.addlocalmodifier("once", 0, 0, "zoom", "replace", 0.1, 0.3);
        emitter.addglobalmodifier("impulse", 0.2, 0.2, "spin", "multiply", 0.6, 0.6);

      }
}
