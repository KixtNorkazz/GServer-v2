//#CLIENTSIDE
function onCreated()
{dontblock;
  drawunderplayer();
  setimgpart("malinko_boat.png",16*10+8,0,105,64);
  y -= .25;
  this.changeRate = .01;//CAN NOT BE 0
  this.maxMovements = .25;//in y
  this.stepc = 0;
  setTimer(.1);
}
function onTimeout()
{
  //setcharani("idle","idle");
  y += this.changeRate;
  if (this.changeRate > 0)
  {
    this.stepc += this.changeRate;
  }else if (this.changeRate < 0)
  {
    this.stepc += (this.changeRate * -1);
  }
