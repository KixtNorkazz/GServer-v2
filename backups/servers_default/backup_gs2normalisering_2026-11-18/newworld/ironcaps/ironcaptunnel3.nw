//#CLIENTSIDE
function onCreated() {
drawover;

  with (findimg(200)) {
    // Emitter attributes
    layer = 0;
    emitter.delaymin =.2;
    emitter.delaymax =.25;
    emitter.nrofparticles = 8;
    emitter.maxparticles= 200;

    // Basic particle attributes
    emitter.particle.lifetime = 4;
    emitter.particle.image = "g4_particle_cloud.png";//light2s.png
    emitter.particle.mode = 2; // light
    emitter.particle.red = .4;
    emitter.particle.green = 1;
    emitter.particle.blue = .1;
    emitter.particle.alpha = 0.05;
    emitter.particle.angle=3*pi /2;
    emitter.particle.zoom = .6;
    emitter.particle.speed=1;

    // Movement

    emitter.addlocalmodifier("once",0,0,"x","add",0,6);
    emitter.addlocalmodifier("once", 0, 0, "speed", "replace", 0.6, 1.2);
    emitter.addglobalmodifier("range", 0, 0, "zangle", "add", -3, -3);
    emitter.addlocalmodifier("range", 2.5, 3, "zoom", "replace", 0.6, 0);
    emitter.addglobalmodifier("impulse", 0.2, 0.2, "spin", "multiply", 0.9, 0.9);
    emitter.addlocalmodifier("once", 0, 0, "rotation", "replace", 0, 2*pi);

  }
}
NPCEND
