  this.defaultX = this.x;
  this.moveInc = .1;
  this.loopSpeed = .05;

  setTimer(random(.05,.25));
}

function onTimeout()
{
  if (this.CountDown <= 0)
  {
    this.CountDown = 0;
    this.x += this.moveInc;


    if (this.x > this.maxMove || this.x < this.defaultX)
    {
