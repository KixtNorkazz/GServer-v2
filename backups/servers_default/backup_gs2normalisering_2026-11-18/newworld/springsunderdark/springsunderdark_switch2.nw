function onActionLeftMouse() {
  if (this.w==160) {
    dontblock();
    this.m = 1;
    this.setTimer(.05);
  }
  else {
    blockagain();
    this.m = 2;
    this.setTimer(.05);
  }
}
function onTimeout() {
  showimg(1,"val_whitespring_templedoor.gif",x,y);
  changeimgpart(1,0,160-this.w,128,this.w);
  if (this.m==1) {
    if (this.w>=8) {
      this.w -= 4;
    }
    else {
      hideimg(1);
      this.m==0;
    }
  }
  else if (this.m==2) {
    if (this.w<=(156)) {
      this.w += 4;
    }
    else {
      this.m==0;
    }
  }
  this.setTimer(.05);
  changeimgvis(1, 1);
}
