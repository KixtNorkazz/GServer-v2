NPC shiridian-gate1.gif 40 0
// The gate: click it to open or close it. The state lives on the server, so every player sees the same (17 Nov 2026,
// as val_greendale_gate_02; the old one had the mouse handler in the server part, where clicks never arrive).
if (created) {
  this.open = 0;
  setimg shiridian-gate1.gif;
  setshape 1,128,112;
}
if (actiongate) {
  if (this.open == 0) {
    this.open = 1;
    setimg val_gate_open.png;
    dontblock;
  } else {
    this.open = 0;
    setimg shiridian-gate1.gif;
    blockagain;
  }
}
//#CLIENTSIDE
function onMouseDown(mods, mx, my) {
  if (mousex >= this.x && mousex <= this.x + 8 && mousey >= this.y && mousey <= this.y + 7) {
    triggeraction(this.x + 4, this.y + 3, "gate", "");
  }
}
