//#CLIENTSIDE
function onCreated() {
  setshape 1,64,80;
  this.w = 32;
  showimg(1,"bridgeton-porticullis.gif",x,y);
  changeimgpart(1,32,0,32,64);
  showimg(2,"bridgeton-porticullis.gif",x+2,y);
  changeimgpart(2,0,0,32,64);
  changeimgvis 1,1;
  changeimgvis 2,1;
}
function onActionLeftMouse() {
  if (this.w==32) {
    dontblock();
    this.m = 1;
    this.setTimer(.05);
  }
  else {
    this.m = 2;
    this.setTimer(.05);
  }
}
function onTimeout() {
  showimg(1,"bridgeton-porticullis.gif",x,y);
  changeimgpart(1,64-this.w,0,this.w,64);
  showimg(2,"bridgeton-porticullis.gif",x+2+(2-(this.w/16)),y);
  changeimgpart(2,0,0,this.w,64);
  if (this.m==1) {
    if (this.w>=8) {
      this.w -= 4;
    }
    else {
      hideimg(1);
      hideimg(2);
      this.m==0;
    }
  }
  else if (this.m==2) {
    if (this.w<=(28)) {
      this.w += 4;
    }
    else {
      blockagain();
      this.m==0;
    }
  }
  this.setTimer(.05);
  changeimgvis 1,1;
  changeimgvis 2,1;
}
NPCEND
