function onCreated()
{
  setshape(1,4*16,1*16);
  setTimer(0.05);
}

function onTimeout()
{
  if (player.z > 0 && InBounds())
  {
    else if (player.dir == 1)
      player.x--;
    else if (player.dir == 3)
      player.x++;
  }

  setTimer(0.05);
}

function InBounds()
{
  if (player.x in |(this.x-2.5),(this.x)+this.width| && player.y in |(this.y-3.5),(this.y-1)+this.height|)
      return true;
  else
      return false;
}
