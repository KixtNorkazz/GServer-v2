NPC - 11 26
//#CLIENTSIDE
function onCreated()
{
  setshape(1,3*16,3*16);
  dontblock();
  setTimer(0.05);
}

function onTimeout()
{
  if (player.z > 0 && InBounds())
  {
    if (player.dir in {1,2})
    {
      player.x--;
      player.y++;
    }
    else if (player.dir in {3,0})
    {
      player.x++;
      player.y--;
    }
  }

  setTimer(0.05);
}

function InBounds()
{
  if (player.x in |(this.x-2.5),(this.x)+this.width| && player.y in |(this.y-3.5),(this.y-1)+this.height|)
      return true;
  else
      return false;
}
