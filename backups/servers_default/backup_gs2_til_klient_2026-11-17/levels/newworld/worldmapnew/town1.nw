function onTimeout()
  {
  this.rtime = random(.25,5);
  this.rdir = int(random(1,4));
  this.rm = int(random(1,4));

  if (this.rdir < 3)
    {
    dir = this.rdir;
  }
  else
    {
    dir = 3;
  }
  if (this.rm == 1)
  {
     message("");
     sleep(1);
  }
  else if (this.rm == 2)
  {
     message("");
     sleep(1);
  }
  else if (this.rm == 3)
  {
     message("");
     sleep(1);
  }
  else if (this.rm >= 0)
  {
     message("");
     sleep(.5);
  } else { message("SHT ERROR..brb.."); }

  setTimer(this.rtime);
}

