NPC - 10 45
//#CLIENTSIDE
if (created) {
  // Initialize the attributes
  showcharacter;
  setcharprop #P1,none.gif;
  setcharprop #3,val-nohead.png;
  setcharprop #C0,darkgreen;
  setcharprop #C1,brown;
  setcharprop #C2,brown;
  setcharprop #C3,darkgreen;
  setcharprop #C4,lightgray;
  setcharprop #n,Rabbit;
  setcharprop #2,no-shield.png;
  setcharprop #8,no-body.gif;
  shieldpower = 0;
  ap = 100;
  dontblock;
}
if (playerenters || timeout) {
  setstring this.name,tamachan;
  setcharani val_rabbit-idle, idle;

  this.randomx=int(random(-2,2));
  this.randomy=int(random(-2,2));

  if (!onwall(x+1.5*this.randomx,y+2*this.randomy) && !onwater(x+1.5*this.randomx,y+2*this.randomy )) {
    move this.randomx,this.randomy,1,4+8+16+32;
    setcharani val_rabbit-walk,walk;
  }
  sleep 1;

  setcharani val_rabbit-idle, idle;
  timeout = random(2,5);
}
NPCEND
