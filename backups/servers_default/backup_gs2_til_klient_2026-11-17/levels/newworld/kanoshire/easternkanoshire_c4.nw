NPC - 14 5
//#CLIENTSIDE
if (created)
{
  showcharacter;
  setcharprop #3,val-nohead.png;
  setcharani silentswim,;
  dontblock;
  dir = 2;
  y += .75;

  this.my = .1; //distance per loop(movement y)
  this.steptillflip = 0; //step counter
  this.msteptillflip = 2; //max steps
  this.loopspeed = .25; //pause between loops
  this.dpause = .5; //pause between direction change

  sleep .05;

  timeout = this.loopspeed;
}

if (timeout)
{
  y-=this.my;
  this.steptillflip += 1;
  if (this.steptillflip >= this.msteptillflip)
  {
    this.my *= -1;
    this.steptillflip = 0;
    sleep this.dpause;
  }
  timeout = this.loopspeed;
}
NPCEND
