function OnCreated()
    {
       settimer(0.05); }

function InBounds()
	{
	  if (player.x in |(this.x-20.5),(this.x)+this.width| && player.y in |(this.y-20.5),(this.y-1)+this.height|)
	      return true;
	  else
	      return false;
	}

function onTimeout()
	{
	  if (InBounds())
	  {
	    Jump.ForceJump(7.2);
	  }
	  setTimer(.1);
	}
NPCEND
