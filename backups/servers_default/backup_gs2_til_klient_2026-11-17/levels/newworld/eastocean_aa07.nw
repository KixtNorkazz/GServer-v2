NPC val_newlucca_top1.gif 60 12
//#CLIENTSIDE
function onCreated() {

  this.imageLength = 10; //Image length in X
  this.imageHeight = 8; //Image height in Y

  this.glowMax = .2; //the max the image will glow at
  this.glowRate = .025; //leave this if you can't tell what it does..
  this.glowRed = 1; // the red color in the glow
  this.glowGreen = 1; // the green color in the glow
  this.glowBlue = 1; // the blue color in the glow



//No need to touch ANYTHING below if you've touched above where you should of.



  this.glow = this.glowMax;
  this.touched = 0;
  dontblock();
  drawoverplayer();
  setTimer(.1);
}

function onTimeout()
  {
  if (player.x in |x-1,x - 1.5 + this.imageLength| && player.y in |y - 2.5,y - 1.5 + this.imageHeight|)
    {
    glow();
  }else
      {
    this.touched = 1;
    setcoloreffect 1,1,1,1;
  }
  setTimer(.15);
}

function glow()
  {
  if (this.touched == 0)
    {
    this.glow = this.glowMax;
    this.touched == 1;
  }

  this.glow -= this.glowRate;
  setcoloreffect this.glowRed,this.glowGreen,this.glowBlue,this.glow;

  if (this.glow <= this.glowMax - this.glowMax / 4 || this.glow > this.glowMax)
    {
    this.glowRate *= -1;
  }
}
NPCEND
