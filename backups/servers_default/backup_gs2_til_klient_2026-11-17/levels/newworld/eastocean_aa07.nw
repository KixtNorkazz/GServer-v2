function onCreated()
  {
  x -= .5;
  showcharacter();
  nick = "'The Box Merchant'";
  bodyimg = "val_smallerbody101.gif";
  headimg = "val-outlawcloakhead2.gif";
  shieldimg = "no-shield.gif";
  dir = 2;

  if (serverr.timesecond <= 14800)
    {
    this.doneit2 = true;
  }

  setTimer(.25);
}

function onTimeout()
  {
  //HIDE
  if (serverr.timesecond >= 19000  &&  this.doneit == false)
    {
    this.setcharani("kneel1", "kneel1");
    sleep(.25);
    this.setcharani("lift", "lift");
    sleep(.25);
    this.setcharani("walk", "walk");
    move(0,1,.25,1);
    sleep(.5);
    this.setcharani("kneel1", "kneel1");
    hide();
    this.doneit = true;
  }else if (serverr.timesecond < 19000)
      {
    this.doneit = false;
  }

  //SHOW
  if (serverr.timesecond <= 14800  &&  this.doneit2 == false)
    {
    this.setcharani("kneel1", "kneel1");
    show();
    sleep(.25);
    this.setcharani("lift", "lift");
    sleep(.25);
    this.setcharani("walk", "walk");
    move(0,-1,.25,1);
    sleep(.5);
    this.setcharani("idle", "idle");
    this.doneit2 = true;
  }else if (serverr.timesecond > 14800)
      {
    this.doneit2 = false;
  }

   this.rm = int(random(1,6));

  if (this.rm == 1)
  {
     setcharani("idle","idle");
  }else if (this.rm == 2)
  {
     setcharani("sit","sit");
  }else if (this.rm == 3)
  {
     setcharani("dance3","dance3");
  }else if (this.rm == 4)
  {
     setcharani("kneel1","kneel1");
  }else if (this.rm >= 5)
  {
     setcharani("push","push");
  }else{message("Wtf I error'd! HALP! Call the ambumalance!");}

  setTimer(5);
}
