NPC val_fog.png 22 20
//FORWARD >
//#CLIENTSIDE
function onCreated()
{
  setcoloreffect(1,1,1,.99);
  setzoomeffect(random(5,10));
  drawaslight();
  dontblock();

  this.maxMove = this.x + random(6,15);

  this.defaultX = this.x;
  this.moveInc = .1;
  this.loopSpeed = .05;

  setTimer(random(.05,.25));
}

function onTimeout()
{
  if (this.CountDown <= 0)
  {
    this.CountDown = 0;
    this.x += this.moveInc;


    if (this.x > this.maxMove || this.x < this.defaultX)
    {
      this.moveInc*=-1;
      this.CountDown = random(0,3);
    }
  }
  else
  {
    this.CountDown -= this.loopSpeed;
  }

  setTimer(this.loopSpeed);
}
