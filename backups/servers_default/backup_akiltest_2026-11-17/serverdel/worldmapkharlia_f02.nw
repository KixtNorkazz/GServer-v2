  dontblock();

  this.maxMove = this.x + 5;

  this.defaultX = this.x;
  this.moveInc = .1;
  this.loopSpeed = .2;

  setTimer(.05);
}

function onTimeout()
{
  if (this.CountDown <= 0)
  {
    this.CountDown = 0;
    this.x += this.moveInc;


    if (this.x > this.maxMove || this.x < this.defaultX)
    {
      this.moveInc*=-1;
      this.CountDown = .5;
    }
  }
  else
  {
    this.CountDown -= this.loopSpeed;
  }

  setTimer(this.loopSpeed);
}
