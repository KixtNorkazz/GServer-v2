//#CLIENTSIDE
// Robert the Trader by his cart: grumbles now and then (the first line was commented out by its author and stays silent).
function onCreated() {
  showcharacter();
  nick = "Robert the Trader";
  headimg = "head5.png";
  bodyimg = "arwind-mercbody6.gif";
  dir = 0;
  setcharani("merchantcart-idle", "merchantcart-idle");
  setTimer(0.1);
}
function onTimeOut() {
  this.rtime = random(0.25, 4);
  this.rm = int(random(1, 4));
  if (this.rm == 2) {
    message("C'mon, c'mon! Those radishes won't load themselves.");
    sleep(2);
    message(" ");
    sleep(0.5);
  } else if (this.rm == 3) {
    message("Those vegetable crates loaded yet?");
    sleep(3);
    message(" ");
    sleep(0.5);
  } else {
    sleep(2.5);
  }
  setTimer(this.rtime);
}
