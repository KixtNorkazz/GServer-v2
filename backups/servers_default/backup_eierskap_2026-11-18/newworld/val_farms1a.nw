function onCreated()
  {
  with(findimg(10))
    {
    x=x;
    y=y;
    emitter.autorotation=false;
    emitter.nrofparticles = 1;
    emitter.isfrozen = false;
    emitter.delaymin=.1;
    emitter.delaymax=.1;
    emitter.maxparticles=50;
    emitter.particle.image = "g4_particle_cloud.png";
    emitter.particle.spin = 1;
    emitter.particle.alpha = .1;
    emitter.particle.lifetime=2;
    emitter.particle.speed = 1;
    emitter.particle.zoom = .2;
    emitter.particle.mode = 0;
    emitter.particle.angle = degtorad(80);;
    emitter.addlocalmodifier("once",0,0,"spin","replace",-1,1);
    emitter.addlocalmodifier("range",0,5,"angle","replace",degtorad(80),0);
    emitter.addlocalmodifier("range",0,6,"speed","replace",3,7);
    emitter.addlocalmodifier("range",0,5,"zoom","replace",.2,3);
    emitter.addlocalmodifier("range",0,6,"alpha","replace",.1,0);
    emitter.emit();
  }
}
