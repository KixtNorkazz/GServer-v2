}
if (playerchats&&strequals(#g,Road Wardens) || strequals(#a,TashGraal)) {
  if (strequals(#c,Close Gate)){
    sleep 0.5;
    setcharprop #c,*clink clink clink*;
    sleep 0.1;
    setimgpart bridgeton-porticullis.gif,0,32,200,200;
    sleep 0.1;
    setimgpart bridgeton-porticullis.gif,0,16,200,200;
    sleep 0.1;
    setimgpart bridgeton-porticullis.gif,0,0,200,200;
    blockagain;
    drawunderplayer;
    sleep 0.2;
    setcharprop #c, *boom*;
    sleep 2;
    setcharprop #c,;
}
}

if (playerchats&&strequals(#g,Road Wardens) || strequals(#a,TashGraal)) {

  if (strequals(#c,Open Gate)){
    sleep 0.5;
    setcharprop #c,*clink clink clink*;
    sleep 0.1;
    setimgpart bridgeton-porticullis.gif,0,16,200,200;
    dontblock;
    drawoverplayer;
    sleep 0.1;
    setimgpart bridgeton-porticullis.gif,0,32,200,200;
    sleep 0.1;
    setimgpart bridgeton-porticullis.gif,0,46,200,200;
    sleep 0.2;
    setcharprop #c, *ka-chak*;
    sleep 1;
    setcharprop #c,;
}
}
