    if (startswith(/manager,#c)) {
    tokenize #c;
    setstring serverr.tarumeishu-inn-manager,#a;
    replacestring serverr.tarumeishu-inn,0,#a;
    }

    if (startswith(/read,#c)) {
    message #s(serverr.tarumeishu-inn);
    sleep 2;
    message ;
    timeout = 0.5;
