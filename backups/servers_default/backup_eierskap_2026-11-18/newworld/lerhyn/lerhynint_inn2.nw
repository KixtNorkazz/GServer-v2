// NPC made by Saeyn (LAT)
//#CLIENTSIDE
if (created) {
  setimg Teahouseroof1.gif;
  drawoverplayer;
  dontblock;
  timeout = 0.05;

}
if(timeout){
  if(playerx in |x-4,x+7|&&playery in |y-3,y+10|){
    drawaslight;
    setcoloreffect 1,1,1,0.2;
  } else {
    blockagain;
    setcoloreffect 1,1,1,1;
    dontblock;
  }
  timeout = 0.05;
}
