// Scripted by Chris (RP Admin)
// (the GS2 code that stood here was moved to the client part on 17 Nov 2026)
//#CLIENTSIDE
function onCreated() {
  // from the server part (GS2, which the server does not run)
this.gate1 = 0;

  setshape2(2, 3, {
  22,22,22,
  22,22,22,
  22,22,22,
  22,22,22,
  22,22,22,
  22,22,22,
    });
}
function onPlayerChats() {
if (player.account == "hellsinging" || player.account == "BurningStarlight" || player.account == "PloKoonDS" || player.account == "EviloFisho") {

if (player.chat == "/openbath" && this.gate1 == 0) {
move(0,0,0,0);
sleep(2);
move(-2,0,2,0);
sleep(1);
this.gate1 = 1;
}

if (player.chat == "/closebath" && this.gate1 == 1) {
move(0,0,0,0);
sleep(2);
move(2,0,2,0);
sleep(1);
this.gate1 = 0;
}
}
}
