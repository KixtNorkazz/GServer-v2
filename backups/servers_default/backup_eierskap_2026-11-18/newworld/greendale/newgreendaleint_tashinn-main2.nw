//#CLIENTSIDE
function onCreated()
{
  this.loopSpeed=0.05;
  setTimer(this.loopSpeed);
}

function onTimeout()
{
  if (this.day==true)
    seteffect(0,0,0,0);
  else
    seteffect(0,0,0,.3);

  setTimer(this.loopSpeed);
}

function onPlayerchats()
{
  if (player.chat=="Day")
      this.night=false;
  else if(player.chat=="Night")
      this.night=true;
}
