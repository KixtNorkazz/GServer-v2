// ADDER/REMOVER
//#SERVERSIDE
if (playerchats)
  {
  if (strequals(#a,VanDrake))
    {
    if (startswith(/add,#c))
      {
      tokenize #c;
      if (tokenscount == 2)
        {
        with (getplayer(#t(1)))
          {
          set client.EngineerGuild_access;
        }
      }
    }
    if (startswith(/remove,#c))
      {
      tokenize #c;
      if (tokenscount == 2)
        {
        with (getplayer(#t(1)))
          {
          unset client.EngineerGuild_access;
        }
      }
    }
  }
}

// END ADDER/REMOVER
