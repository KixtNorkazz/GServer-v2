//Script written by Chris
// (the GS2 code that stood here was moved to the client part on 17 Nov 2026)
//#CLIENTSIDE
function onCreated() {
  // from the server part (GS2, which the server does not run)
  this.gate1 = 0;
  this.x = x;
  this.y = y;
  this.allowed = {"fireball1000"};

  setshape2(6, 3, {
21,21,21
21,21,21
21,21,21
21,21,21
21,21,21
21,21,21
});
}
function onPlayerChats() {
  if (player.account in this.allowed) {
    if (player.chat == "Open." && this.gate1 == 0) {
      move(0,0,4,0);
      sleep(0);
      move(6,0,3,0);
      sleep(3);
      this.gate1 = 1;
    }
    if (player.chat == "Close." && this.gate1 == 1) {
      move(-6,0,2,0);
      sleep(3);
//      move(6,0,3,0);
//      sleep(2);
      this.gate1 = 0;
    }
    if (player.chat == "/reset") {
      x = this.x;
      y = this.y;
      this.gate = 0;
    }
  }
}
