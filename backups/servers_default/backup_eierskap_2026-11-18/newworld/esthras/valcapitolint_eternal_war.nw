    {
    if (strequals(#c,lock))
      {
      this.lockc = 1;
    }
    if (strequals(#c,unlock))
      {
      this.lockc = 0;
    }
  }
}

if (playertouchsme)
  {
  if (this.lockc == 1)
    {
    say2#b
    ::The door is locked::;
    show;
  }
  else
    {
    hide;
    if (strequals(#a,Eternal_War))
    {
      this.lockc = 1;
    }
    sleep 2;
    show;
  }
}
