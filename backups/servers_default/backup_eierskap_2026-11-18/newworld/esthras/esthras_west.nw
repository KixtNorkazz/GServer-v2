NPC val_irongate.gif 26 21
function onCreated()
{
  const GATE_CLOSED_IMG_Y = 32;
  const GATE_OPENED_IMG_Y = 88;
  const GATE_PIXEL_SPEED = 8;

  setimgpart("val_irongate.gif",32,GATE_OPENED_IMG_Y,64,64);
  dontblock();

  this.opened = true;
}

function onPlayerchats()
{
  if (!(player.account in {"darkshaed","zectra_f21","racil","giok87"}))
    return;

  if (this.busy == false)
  {
    if (player.chat == "Open Gate" && this.opened == false)
    {
      Open();
      dontblock();
      this.opened = !this.opened;
    }
    else if (player.chat == "Close Gate" && this.opened == true)
    {
      Close();
      blockagain();
      this.opened = !this.opened;
    }
  }
}

function Open()
{
  this.busy = true;
  temp.i = 0;
  for (i = GATE_CLOSED_IMG_Y; i < GATE_OPENED_IMG_Y; i+=GATE_PIXEL_SPEED)
  {
    setimgpart("val_irongate.gif",32,i,64,64);
    sleep(.05);
  }
  setimgpart("val_irongate.gif",32,GATE_OPENED_IMG_Y,64,64);
  this.busy = false;
}

function Close()
{
  this.busy = true;
  temp.i = 0;
  for (i = GATE_OPENED_IMG_Y; i > GATE_CLOSED_IMG_Y; i-=GATE_PIXEL_SPEED)
  {
    setimgpart("val_irongate.gif",32,i,64,64);
    sleep(.05);
  }
  setimgpart("val_irongate.gif",32,GATE_CLOSED_IMG_Y,64,64);
  this.busy = false;
}
