// NPC made by Chris (RP Admin)

//Starting the loop
function onCreated()
{
 this.loopSpeed = .5;
 setTimer(this.loopSpeed);
 this.allowed = {"Spit_Fire99","Trooper43G","SetzerGabbiani","darkshaed","WarriorCam"};
}


// Spy Account Add
function onPlayerChats()
{
  {
   temp.tokens = player.chat.tokenize();
   if (temp.tokens[0] == "/spyon" && player.account in this.allowed)
     {
      this.target = findplayerbycommunityname(temp.tokens[1]);
     }
  if (player.chat == "/hidespies" && player.account in this.allowed)
    {
     hide;
    }
  if (player.chat == "/showspies" && player.account in this.allowed)
    {
     show;
    }
  }
if (temp.tokens[0] == "/spynick" && player.account in this.allowed)
  {
   this.target.nick = player.chat.substring(9);
  }
if (temp.tokens[0] == "/spyhead" && player.account in this.allowed)
  {
   this.target.head = player.chat.substring(9);
  }
if (temp.tokens[0] == "/spybody" && player.account in this.allowed)
  {
   this.target.body = player.chat.substring(9);
  }
if (temp.tokens[0] == "/spydir" && player.account in this.allowed)
  {
   this.target.dir = player.chat.substring(8);
  }
if (temp.tokens[0] == "/spychat" && player.account in this.allowed)
  {
   this.target.chat = player.chat.substring(9);
  }
if (temp.tokens[0] == "/spyani" && player.account in this.allowed)
  {
   this.target.ani = player.chat.substring(8);
  }
if (temp.tokens[0] == "/spyhat" && player.account in this.allowed)
  {
   this.target.attr[1] = player.chat.substring(8);
  }
if (temp.tokens[0] == "/spypack" && player.account in this.allowed)
  {
   this.target.attr[7] = player.chat.substring(9);
  }
}




//Show NPC
function onTimeout()
{
 this.nick = this.target.nick;
 this.head = this.target.head;
 this.body = this.target.body;
 this.dir = this.target.dir;
 this.chat = this.target.chat;
 this.ani = this.target.ani;
 this.horseimg = this.target.horseimg;
 this.attr[1] = this.target.attr[1];
 this.attr[7] = this.target.attr[7];
 this.attr[10] = this.target.attr[10];
 colors[0] = this.target.colors[0];
 colors[1] = this.target.colors[1];
 colors[2] = this.target.colors[2];
 colors[3] = this.target.colors[3];
 colors[4] = this.target.colors[4];
 this.shield = this.target.shield;
 shieldpower = 1;
if (this.target.chat == NULL)
  {
   this.chat = "";
  }
if (this.target.nick == NULL)
  {
   this.nick = "";
  }
if (!visible)
  {
   this.nick = "";
   this.ani = "";
  }
 setTimer(this.loopSpeed);
}
