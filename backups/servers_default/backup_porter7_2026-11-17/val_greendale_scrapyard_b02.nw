NPC val_irongate2.gif 28 29
function onActionLeftMouse() {
  triggeraction x,y,Open,;
  setshape 1,16*8,16*7;
  this.setTimer(.05);
}
//#CLIENTSIDE
function onCreated() {
  this.img = "val_irongate2.GIF";
  this.alpha = 0;
  setshape 1,16*8,16*7;
  this.w = 16*8;
  showimg(1,this.img,x,y);
  changeimgpart(1,0,0,16*4,16*7);
  showimg(2,this.img,x+4,y);
  changeimgpart(2,16*4,0,16*4,16*7);
  changeimgvis 1,1;
  changeimgvis 2,1;
}
if (actionOpen) {
  if (this.w==16*8) {
    dontblock();
    this.m = 1;
    this.setTimer(.05);
  }
  else {
    this.m = 2;
    this.setTimer(.05);
  }
}
function onTimeout() {
  showimg(1,this.img,x,y);
  changeimgpart(1,16*4-this.w/2,0,this.w/2,16*7);
  showimg(2,this.img,x+4+(4-(this.w/32)),y);
  changeimgpart(2,16*4,0,this.w/2,16*7);
  if (this.m==1) {
    if (this.w>=8) {
      this.w -= 4;
    }
    else {
      hideimg(1);
      hideimg(2);
      this.m==0;
    }
  }
  else if (this.m==2) {
    if (this.w<=(16*8-4)) {
      this.w += 4;
    }
    else {
      blockagain();
      this.m==0;
    }
  }
  this.setTimer(.05);
  changeimgvis 1,1;
  changeimgvis 2,1;
}
NPCEND
