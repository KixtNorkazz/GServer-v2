if (created) {
  setimg light2s.png;
  dontblock;
}
//#CLIENTSIDE
if (playerenters) {
  spawn();
  setcoloreffect 1,1,1,0.29;
  drawaslight;
  timeout=.05;
}

function spawn() {
  x=random(0,64);
  y=random(0,64);
  if (onwall(x,y)) {
    x=random(0,64);
    y=random(0,64);
    spawn();
  }
}

if (timeout) {
  this.dx=random(-7,7);
  this.dy=random(-1,1);
  move this.dx,this.dy,7,4+8;
}
if (movementfinished) {
    timeout=.05;
}

setzoomeffect .5;
NPCEND
