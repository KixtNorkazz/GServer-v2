function onPlayerEnters() {
  temp.effect = client.timeeffect;
  temp.i = 1;
  while(temp.i > temp.effect[3]) {
    temp.i -= 0.05;
    seteffect(temp.effect[0], temp.effect[1], temp.effect[2], temp.i);
    sleep(0.05);
  }
  enabledefmovement();
}
