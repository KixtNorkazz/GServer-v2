function gs1_always() {
  if (this.mode==1) {
    if (player.x in |this.x-1,this.x+this.width| && player.y in |this.y-4,this.y+2|) {
      if (this.created) {
        this.i = 2;
      }
      if (this.h>=64) {
        this.h = 0;
      } else if (this.h<64) {
        this.h++;
      }
      if (this.i>=100) {
        this.i = 1;
      }
      if (this.i<100&&this.i==2) {
        this.i++;
      }
      if (this.i<100&&this.i==1) {
        this.i--;
      }
      if (this.i<=0) {
        this.i = 2;
      }
      showimg(this.i, "light2.png", this.x+this.h, this.y-5);
      changeimgvis(this.i, 3);
      changeimgcolors(this.i, random(.4, .9), random(.4, .9), random(.4, .9), random(.4, .9));
    }
  }
  setTimer(.05);
}
