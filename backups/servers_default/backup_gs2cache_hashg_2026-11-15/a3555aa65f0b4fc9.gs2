//#CLIENTSIDE
function onPlayerChats() {
  if (("#g" == "Staghorn")) {
    if ((player.chat == "Sentry")) {
      player.colors[0] = "orange";
      player.colors[1] = "darkblue";
      player.colors[2] = "white";
      player.colors[3] = "yellow";
      player.colors[4] = "blue";
      player.shield = "ryo250-woodenspearshield.gif";
      player.body = "cythussuirikubody.gif";
      player.attr[1] = "hat-dalmartrooper1.gif";
    }
  }
  if (("#g" == "Staghorn")) {
    if ((player.chat == "Ranger")) {
      player.colors[0] = "orange";
      player.colors[1] = "darkblue";
      player.colors[2] = "white";
      player.colors[3] = "yellow";
      player.colors[4] = "blue";
      player.shield = "bow-shield2.gif";
      player.body = "nadrion_valikorlian-nation-rangerbody.png";
      player.attr[1] = "hat.gif";
    }
  }
}

function onPlayerEnters() {
  level.inside = 1;
  setTimer(0.05);
}

function onTimeOut() {
  seteffect(0, 0, 0, .1);
  setTimer(0.05);
}
