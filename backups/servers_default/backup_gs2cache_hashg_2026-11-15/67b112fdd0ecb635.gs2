//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.head = "theblindone-asian-head.gif";
  this.colors[0] = "orange";
  this.colors[1] = "yellow";
  this.colors[2] = "white";
  this.attr[1] = "hat-111333.png";
  this.colors[3] = "red";
  this.colors[4] = "cynober";
  this.nick = "Ordinator of (Imperial Dalmar)";
  this.shield = "no-shield.gif";
  this.shieldpower = 1;
  this.dir = 2;
  this.ap = 100;
  this.body = "xiji-darkarmorbody.gif";
}

function onPlayerEnters() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}

function onPlayerTouchsMe() {
  if (("#g" == "Imperial Dalmar")) {
    if ((player.nick.pos("Emperor") > -1)) {
      message("*Bows Low* Your Grace.");
      sleep(3);
      message();
    }
    if ((player.nick.pos("Trooper") > -1)) {
      message("Why are you away from your post?");
      sleep(3);
      message();
    }
    if ((player.nick.pos("Officer") > -1)) {
      message("Good day, Officer.");
      sleep(3);
      message();
    }
    if ((player.nick.pos("Ordinator") > -1)) {
      message("Be ever watchful.");
      sleep(3);
      message();
    }
    if ((player.nick.pos("Commander") > -1)) {
      message("*Salute* Commander.");
      sleep(3);
      message();
    }
  }
}

function onTimeOut() {
  this.name = "tamachan";
  setcharani("idle", this.idle);
  this.randomx = int(random(-2, 2));
  this.randomy = int(random(-2, 2));
  if (!onwall(this.x+1.5*this.randomx, this.y+2*this.randomy) && !onwater(this.x+1.5*this.randomx, this.y+2*this.randomy)) {
    move(this.randomx, this.randomy, 1, 4+8+16+32);
    setcharani("walk", this.walk);
  }
  sleep(1);
  setcharani("idle", this.idle);
  setTimer(random(2, 5));
}
