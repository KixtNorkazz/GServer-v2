//#CLIENTSIDE
function onCreated() {
  showcharacter();
  this.shield = "no-shield.gif";
  this.head = "head488.png";
  this.body = "moto-bridgetonbody100.gif";
  this.colors[0] = "lightgray";
  this.colors[1] = "orange";
  this.colors[2] = "white";
  this.colors[3] = "gray";
  this.colors[4] = "black";
  setcharani("0", NULL);
  setcharani("valikorlia_motoxbow2-passive-idle", NULL);
  this.dir = 2;
  this.ap = 100;
  this.nick = "George Prower";
}

function onPlayerTouchsMe() {
  if (("#g" == "Bridgeton")) {
    say2("Nothing to report, as usual.");
  }
  if (!("#g" == "Bridgeton")) {
    say2("Good day, citizen.  The#b
public library rooms are to#b
the left and right over there.");
  }
}
