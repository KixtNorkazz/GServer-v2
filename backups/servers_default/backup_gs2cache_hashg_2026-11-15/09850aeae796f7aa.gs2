//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showcharacter();
  this.guild = "Hammerforge";
  this.head = "setzergabbiani-dwarfhead.gif";
  this.colors[0] = "orange";
  this.colors[1] = "black";
  this.colors[2] = "black";
  this.colors[3] = "gray";
  this.colors[4] = "gray";
  this.attr[1] = "hat1-smeewn.gif";
  this.chat = "";
  this.shield = "";
  this.body = "val-body3.png";
  setcharani("aeglosaxe-idle", NULL);
  this.hearts = 0;
  this.dir = 1;
  this.x = this.x;
  this.speed = .5;
  this.mode = 0;
}

function onPlayerChats() {
  gs1_always();
  if (((this.guild) == "#g")) {
    if ((player.chat == "unguard") && this.mode==0) {
      this.mode = 2;
      setcharani("aeglosaxe-walk", NULL);
    }
    if ((player.chat == "guard") && this.mode==1) {
      this.mode = 4;
      setcharani("aeglosaxe-walk", NULL);
    }
    setTimer(.1);
  }
}

function onTimeOut() {
  gs1_always();
  if (this.mode==2) {
    this.dir = 1;
    if (this.x<=this.x-1) {
      this.mode = 1;
      this.dir = 2;
    }
    this.x -= this.speed;
    setTimer(.1);
  }
  if (this.mode==4) {
    this.dir = 3;
    if (this.x>=this.x-.5) {
      this.mode = 0;
      this.dir = 2;
    }
    this.x += this.speed;
    setTimer(.1);
  }
}

function gs1_always() {
  if (this.mode==0 || this.mode==1) {
    setcharani("aeglosaxe-idle", NULL);
    this.dir = 1;
  }
}
