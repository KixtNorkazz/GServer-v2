//#CLIENTSIDE
function onCreated() {
  setimgpart("valcascourtgate.gif", 0, 0, 16*4, 16*5);
  this.canmove = 0;
  this.gate1 = 0;
}

function onMovementFinished() {
  this.canmove = 0;
}

function onPlayerChats() {
  if (("#g" == "Ivarr")) {
    if (this.canmove==0) {
      if ((player.chat == "open gate2")&&this.gate1==0) {
        this.gate1 = 1;
        this.movtime = 3;
        this.dx = (this.x-4)-this.x;
        move();
      }
      if ((player.chat == "close gate2")&&this.gate1==1) {
        this.gate1 = 0;
        this.movetime = 1;
        this.dx = (this.x+4)-this.x;
        move();
      }
    }
  }
}

function move() {
  this.canmove = 1;
  move(this.dx, 0, this.movtime, 8);
}
