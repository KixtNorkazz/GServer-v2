//#CLIENTSIDE
function onPlayerChats() {
  if ((player.chat == "open gate1") && ("#g" == "Imperial Dalmar")) {
    level.gateopen1 = true;
    hide();
    dontblock();
  }
  if ((player.chat == "close gate1") && ("#g" == "Imperial Dalmar")) {
    level.gateopen1 = false;
    show();
    blockagain();
  }
}
