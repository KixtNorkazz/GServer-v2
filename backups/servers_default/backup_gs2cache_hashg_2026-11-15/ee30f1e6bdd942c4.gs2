//#CLIENTSIDE
function onCreated() {
  gs1_always();
  showcharacter();
  this.guild = "Imperial Warholm";
  this.head = "val_darktemplarhead.gif";
  this.colors[0] = "orange";
  this.colors[1] = "yellow";
  this.colors[2] = "white";
  this.attr[1] = "hat-drow-2222.png";
  this.colors[3] = "red";
  this.colors[4] = "cynober";
  this.nick = "High Ordinator";
  this.shield = "no-shield.gif";
  this.chat = "";
  this.shield = "";
  this.body = "xiji-darkarmorbody.gif";
  setcharani("idle", NULL);
  this.hearts = 0;
  this.dir = 2;
  this.x = this.x;
  this.speed = .5;
  this.mode = 0;
}

function onPlayerChats() {
  gs1_always();
  if (((this.guild) == "#g")) {
    if ((player.chat == "unguard") && this.mode==0) {
      this.mode = 2;
      setcharani("walk", NULL);
    }
    if ((player.chat == "guard") && this.mode==1) {
      this.mode = 4;
      setcharani("walk", NULL);
    }
    setTimer(.1);
  }
}

function onTimeOut() {
  gs1_always();
  if (this.mode==2) {
    this.dir = 1;
    if (this.x<=this.x-1) {
      this.mode = 1;
      this.dir = 2;
    }
    this.x -= this.speed;
    setTimer(.1);
  }
  if (this.mode==4) {
    this.dir = 3;
    if (this.x>=this.x-.5) {
      this.mode = 0;
      this.dir = 2;
    }
    this.x += this.speed;
    setTimer(.1);
  }
}

function gs1_always() {
  if (this.mode==0 || this.mode==1) {
    setcharani("idle", NULL);
    this.dir = 2;
  }
}
